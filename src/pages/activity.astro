---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Activity">
  <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 py-6 flex flex-col h-full bg-surface">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-1">Audit Trail</div>
        <div class="flex items-center gap-3">
          <div class="text-[22px] font-bold text-ink tracking-tight">Activity</div>
          <div id="act-sub" class="text-[12px] font-semibold text-accent bg-accent-soft px-2 py-0.5 rounded-full">—</div>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <button id="act-refresh" type="button"
          class="h-10 px-5 rounded-xl bg-white hover:bg-surface-hover text-ink border border-hairline text-[13px] font-bold transition-colors shadow-sm flex items-center gap-2">
          <i class="bi bi-arrow-clockwise text-[14px]"></i> Refresh
        </button>
      </div>
    </div>

    <!-- Filter Pills -->
    <div id="act-filters" class="flex gap-2 overflow-x-auto pb-2 mb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <button type="button" data-cat="all" class="shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-ink text-white shadow-md transition-all">All Activity</button>
      <button type="button" data-cat="appointments" class="shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-white text-ink-mute hover:border-accent transition-all">Appointments</button>
      <button type="button" data-cat="followups" class="shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-white text-ink-mute hover:border-accent transition-all">Follow-ups</button>
      <button type="button" data-cat="calls" class="shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-white text-ink-mute hover:border-accent transition-all">Calls</button>
      <button type="button" data-cat="patients" class="shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-white text-ink-mute hover:border-accent transition-all">Patients</button>
    </div>

    <!-- Activity List -->
    <div class="flex-1 overflow-y-auto bg-white rounded-2xl shadow-sm border border-hairline">
      <div id="act-list" class="divide-y divide-hairline">
        <!-- Filled by JS -->
      </div>
    </div>

  </div>

  <script>
    import { requireAuth, isAdmin } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { listRecent, categoryOf } from '../js/activity.js';
    import { fmtDate, todayISO, addDays } from '../js/date-utils.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      rows: [],
      filter: 'all',
      loading: false
    };

    function esc(s) {
      return String(s == null ? '' : s)
        .split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;')
        .split('"').join('&quot;').split("'").join('&#39;');
    }

    function fmtTime(ms) {
      if (!ms) return '—';
      const d = new Date(ms);
      const h = String(d.getHours()).padStart(2, '0');
      const m = String(d.getMinutes()).padStart(2, '0');
      return `${h}:${m}`;
    }

    function dateKey(ms) {
      const d = new Date(ms);
      const y = d.getFullYear();
      const mo = String(d.getMonth() + 1).padStart(2, '0');
      const da = String(d.getDate()).padStart(2, '0');
      return `${y}-${mo}-${da}`;
    }

    function groupLabel(iso) {
      const t = todayISO();
      if (iso === t) return 'Today';
      if (iso === addDays(t, -1)) return 'Yesterday';
      return fmtDate(iso);
    }

    function pillClass(cat) {
      return {
        appointments: 'bg-accent-soft text-accent',
        followups:    'bg-indigo-50 text-indigo-600',
        calls:        'bg-amber-50 text-amber-600',
        patients:     'bg-emerald-50 text-emerald-600',
        other:        'bg-surface-hover text-ink-mute'
      }[cat] || 'bg-surface-hover text-ink-mute';
    }

    function filtered() {
      if (state.filter === 'all') return state.rows;
      return state.rows.filter((r) => r.category === state.filter);
    }

    function render() {
      const root = $('#act-list');
      const sub = $('#act-sub');
      const list = filtered();

      if (sub) {
        sub.textContent = state.loading
          ? 'Loading…'
          : list.length === 0 ? 'No activity' : `${list.length} entr${list.length === 1 ? 'y' : 'ies'}`;
      }

      if (list.length === 0) {
        root.innerHTML = `
          <div class="p-12 text-center flex flex-col items-center justify-center">
            <div class="w-16 h-16 bg-surface-hover rounded-full flex items-center justify-center mb-4">
               <i class="bi bi-clock-history text-[24px] text-ink-faint"></i>
            </div>
            <div class="text-[15px] font-bold text-ink mb-1">No activity recorded yet.</div>
            <div class="text-[13px] text-ink-mute">Actions you take in Appointments will appear here.</div>
          </div>`;
        return;
      }

      // Group by date
      const groups = [];
      let currentKey = null;
      for (const r of list) {
        const k = dateKey(r.ms);
        if (k !== currentKey) {
          groups.push({ key: k, label: groupLabel(k), items: [] });
          currentKey = k;
        }
        groups[groups.length - 1].items.push(r);
      }

      root.innerHTML = groups.map((g) => `
        <div class="px-6 pt-6 pb-2 bg-surface-hover/30 border-b border-hairline">
          <div class="text-[11px] font-bold uppercase tracking-widest text-ink-mute">${esc(g.label)}</div>
        </div>
        ${g.items.map((r) => `
          <div class="flex items-center gap-4 px-6 py-4 hover:bg-surface-hover transition-colors">
            <div class="w-[50px] shrink-0 text-[13px] font-semibold text-ink-mute tnum">${esc(fmtTime(r.ms))}</div>
            
            <div class="flex-1 min-w-0">
              <div class="text-[14px] font-bold text-ink truncate">${esc(r.label)}</div>
              <div class="text-[12.5px] text-ink-mute truncate mt-0.5">
                ${esc(r.name || '—')}
                ${r.role ? `<span class="mx-1 text-ink-faint">·</span>${esc(r.role)}` : ''}
                ${r.targetId ? `<span class="mx-1 text-ink-faint">·</span><span class="text-ink-faint font-mono text-[11px]">${esc(r.targetId.slice(0, 6))}</span>` : ''}
              </div>
            </div>
            
            <div class="shrink-0">
              <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest ${pillClass(r.category)}">
                ${esc(r.category)}
              </span>
            </div>
          </div>`).join('')}
      `).join('');
    }

    function wireFilters() {
      document.querySelectorAll('[data-cat]').forEach((el) => {
        el.addEventListener('click', () => {
          state.filter = el.getAttribute('data-cat');
          document.querySelectorAll('[data-cat]').forEach((x) => {
            const active = x.getAttribute('data-cat') === state.filter;
            x.className = active
              ? 'shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-ink text-white shadow-md transition-all'
              : 'shrink-0 h-9 px-4 rounded-lg text-[13px] font-semibold border border-hairline bg-white text-ink-mute hover:border-accent transition-all';
          });
          render();
        });
      });
    }

    async function load() {
      state.loading = true;
      render();
      try {
        state.rows = await listRecent(state.clinicId, 200);
      } catch (err) {
        state.rows = [];
      } finally {
        state.loading = false;
        render();
      }
    }

    (async () => {
      const m = await requireAuth();
      if (!isAdmin()) {
        location.replace('/day');
        return;
      }
      state.clinicId = getActiveClinicId();
      wireFilters();
      const refresh = $('#act-refresh');
      if (refresh) refresh.addEventListener('click', () => load());
      await load();
    })();
  </script>
</AppLayout>