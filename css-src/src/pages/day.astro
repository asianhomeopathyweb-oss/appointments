---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Day">
  <!-- Centered floating card on desktop -->
  <div class="max-w-[860px] mx-auto md:my-6 bg-white md:rounded-2xl md:shadow-sm md:border md:border-hairline flex flex-col h-[calc(100vh-52px)] md:h-[calc(100vh-100px)] overflow-hidden">
    
    <!-- Header -->
    <div class="px-4 md:px-6 py-4 border-b border-hairline bg-white/90 backdrop-blur sticky top-0 z-20 shrink-0">
      <div class="flex items-center justify-between gap-3">
        
        <div class="flex items-center gap-2">
          <button id="day-prev" type="button" aria-label="Previous day"
            class="w-9 h-9 grid place-items-center rounded-full hover:bg-surface-hover text-ink-mute transition-colors">
            <i class="bi bi-chevron-left text-[16px]"></i>
          </button>
          <button id="day-next" type="button" aria-label="Next day"
            class="w-9 h-9 grid place-items-center rounded-full hover:bg-surface-hover text-ink-mute transition-colors">
            <i class="bi bi-chevron-right text-[16px]"></i>
          </button>
        </div>

        <div class="text-center">
          <div class="text-[18px] md:text-[20px] font-semibold tnum text-ink" id="day-date">—</div>
          <div class="text-[12.5px] text-ink-mute mt-0.5">
            <span id="day-clinic">—</span>
            <span class="mx-1.5 opacity-50">•</span>
            <span id="day-sub">—</span>
          </div>
        </div>

        <div class="w-[80px] flex justify-end">
          <button id="day-today" type="button"
            class="h-8 px-3 rounded-full bg-accent-soft text-accent text-[12px] font-semibold hover:bg-accent hover:text-white transition-colors hidden">
            Today
          </button>
        </div>
      </div>
    </div>

    <!-- Slot Grid (Scrollable) -->
    <div id="day-grid" class="flex-1 overflow-y-auto bg-white relative">
      <div class="p-10 text-center text-ink-mute animate-pulse">Loading schedule...</div>
    </div>

  </div>

  <script>
    import { startDayView } from '../js/day-view.js';
    import { requireAuth } from '../js/lib/auth-guards.js';

    (async () => {
      await requireAuth();
      await startDayView();
    })();
  </script>
</AppLayout>