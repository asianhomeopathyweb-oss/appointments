---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Follow-up">
  <div class="min-h-[calc(100vh-52px)] md:py-10 md:px-6 bg-[#fafafb]">
    <div class="w-full max-w-[560px] mx-auto bg-white md:rounded-2xl md:shadow-panel md:border md:border-hairline overflow-hidden">

      <div class="px-5 pt-5 pb-4 border-b border-hairline">
        <div class="flex items-start justify-between gap-3 mb-2">
          <div class="min-w-0">
            <div id="fu-name" class="text-[17px] font-semibold truncate">â€”</div>
            <div id="fu-phone" class="text-[12.5px] text-ink-mute truncate">â€”</div>
          </div>
          <button id="fu-close" type="button" aria-label="Close"
            class="w-8 h-8 shrink-0 grid place-items-center rounded-lg hover:bg-surface-hover">
            <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
          </button>
        </div>
        <div class="flex items-center gap-2 text-[12.5px]">
          <span id="fu-status" class="text-ink-mute">â€”</span>
          <span class="text-ink-faint">Â·</span>
          <span class="text-ink-faint">due</span>
          <span id="fu-due" class="text-ink tnum">â€”</span>
          <span id="fu-due-rel" class="text-[12.5px] text-ink-mute"></span>
        </div>
      </div>

      <div id="fu-body">
        <div class="px-5 py-4 border-b border-hairline">
          <div class="grid grid-cols-3 gap-3 text-[12.5px]">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Seen on</div>
              <div id="fu-seen" class="text-ink tnum">â€”</div>
            </div>
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Interval</div>
              <div id="fu-interval" class="text-ink">â€”</div>
            </div>
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Status</div>
              <div id="fu-status-inline" class="text-ink capitalize">â€”</div>
            </div>
          </div>
        </div>

        <div id="fu-actions" class="px-5 py-4 space-y-2 border-b border-hairline"></div>

        <div class="px-5 py-4">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">History</div>
          <div id="fu-history"></div>
        </div>
      </div>

    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { startFollowupView } from '../js/followup-view.js';

    (async () => {
      await requireAuth();
      await startFollowupView();
    })();
  </script>
</AppLayout>