---
import '../../public/assets/style.css';
const { title = 'Appointments' } = Astro.props;
const path = Astro.url.pathname;

const LINKS = [
  { href: '/day',       label: 'Day',        icon: 'bi-calendar3',     adminOnly: false },
  { href: '/book',      label: 'Book',       icon: 'bi-plus-square',   adminOnly: false },
  { href: '/patients',  label: 'Patients',   icon: 'bi-people',        adminOnly: false },
  { href: '/followups', label: 'Follow-ups', icon: 'bi-arrow-repeat',  adminOnly: false },
  { href: '/calls',     label: 'Calls',      icon: 'bi-telephone',     adminOnly: false },
  { href: '/reports',   label: 'Reports',    icon: 'bi-bar-chart',     adminOnly: true  },
  { href: '/activity',  label: 'Activity',   icon: 'bi-clock-history', adminOnly: true  },
  { href: '/settings',  label: 'Settings',   icon: 'bi-gear',          adminOnly: true  }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} — Asian Homeocare</title>
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0d8a7a" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="preconnect" href="https://rsms.me/"/>
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>
<body class="min-h-screen bg-surface text-ink">
  
  <!-- Desktop Header -->
  <header class="hidden md:flex items-center gap-3 h-[52px] px-4 border-b border-hairline bg-white/80 backdrop-blur sticky top-0 z-30">
    <div class="flex items-center gap-2 min-w-[200px]">
      <span class="text-[14px] font-semibold">Appointments</span>
    </div>
    <div id="clinic-switcher-slot-desktop" class="relative"></div>
    <div class="flex-1"></div>
    <div class="flex items-center gap-2">
      <slot name="header-right" />
    </div>
  </header>

  <!-- Mobile Header -->
  <header class="md:hidden flex items-center gap-3 h-[52px] px-4 border-b border-hairline bg-white/80 backdrop-blur sticky top-0 z-30">
    <button id="mobile-menu-btn" class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover -ml-2">
      <i class="bi bi-list text-[20px]"></i>
    </button>
    <div class="flex-1 font-semibold text-[14px]">Appointments</div>
    <div id="clinic-switcher-slot-mobile" class="relative"></div>
  </header>

  <div class="flex h-[calc(100vh-52px)] overflow-hidden">
    
    <!-- Desktop Sidebar -->
    <aside class="hidden md:flex w-[220px] flex-col border-r border-hairline bg-white overflow-y-auto shrink-0">
      <nav class="flex flex-col gap-0.5 p-2" aria-label="Main">
        {LINKS.map((l) => {
          const active = path === l.href || path.startsWith(l.href + '/');
          return (
            <a href={l.href}
               class:list={[
                 "flex items-center gap-2.5 px-3 h-10 rounded-lg text-[14px] transition-colors admin-only",
                 active ? "bg-accent-soft text-accent font-medium" : "text-ink-mute hover:bg-surface-hover"
               ]}
               data-admin-only={l.adminOnly ? "true" : "false"}>
              <i class:list={["bi", l.icon, "text-[15px]"]} aria-hidden="true"></i>
              <span>{l.label}</span>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- Mobile Drawer -->
    <div id="mobile-drawer" class="fixed inset-0 z-40 hidden">
      <div id="mobile-drawer-backdrop" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300"></div>
      <aside id="mobile-drawer-panel" class="absolute inset-y-0 left-0 w-[260px] bg-white -translate-x-full transition-transform duration-300 flex flex-col">
        <div class="flex items-center justify-between h-[52px] px-4 border-b border-hairline shrink-0">
          <span class="font-semibold text-[14px]">Menu</span>
          <button id="mobile-drawer-close" class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover">
            <i class="bi bi-x-lg text-[16px]"></i>
          </button>
        </div>
        <nav class="flex flex-col gap-0.5 p-2 flex-1 overflow-y-auto" aria-label="Mobile Main">
          {LINKS.map((l) => {
            const active = path === l.href || path.startsWith(l.href + '/');
            return (
              <a href={l.href}
                 class:list={[
                   "flex items-center gap-2.5 px-3 h-10 rounded-lg text-[14px] transition-colors admin-only",
                   active ? "bg-accent-soft text-accent font-medium" : "text-ink-mute hover:bg-surface-hover"
                 ]}
                 data-admin-only={l.adminOnly ? "true" : "false"}>
                <i class:list={["bi", l.icon, "text-[15px]"]} aria-hidden="true"></i>
                <span>{l.label}</span>
              </a>
            );
          })}
        </nav>
      </aside>
    </div>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto bg-surface">
      <slot />
    </main>
  </div>

  <script>
    import { requireAuth, isAdmin } from '../js/lib/auth-guards.js';
    import { initClinicSwitcher } from '../js/lib/clinic-switcher.js';

    // Mobile Drawer Logic
    const drawer = document.getElementById('mobile-drawer');
    const panel = document.getElementById('mobile-drawer-panel');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const btnOpen = document.getElementById('mobile-menu-btn');
    const btnClose = document.getElementById('mobile-drawer-close');

    function openDrawer() {
      drawer.classList.remove('hidden');
      setTimeout(() => {
        backdrop.classList.replace('opacity-0', 'opacity-100');
        panel.classList.replace('-translate-x-full', 'translate-x-0');
      }, 10);
    }

    function closeDrawer() {
      backdrop.classList.replace('opacity-100', 'opacity-0');
      panel.classList.replace('translate-x-0', '-translate-x-full');
      setTimeout(() => {
        drawer.classList.add('hidden');
      }, 300);
    }

    if (btnOpen) btnOpen.addEventListener('click', openDrawer);
    if (btnClose) btnClose.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    document.querySelectorAll('#mobile-drawer a').forEach(a => {
      a.addEventListener('click', closeDrawer);
    });

    // Initialize Auth and UI
    (async () => {
      const user = await requireAuth();
      
      if (!isAdmin()) {
        document.querySelectorAll('[data-admin-only="true"]').forEach(el => el.style.display = 'none');
      }

      initClinicSwitcher(user);
    })();
  </script>
</body>
</html>