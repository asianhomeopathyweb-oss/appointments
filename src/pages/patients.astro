---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Patients">
  <div class="max-w-[860px]">

    <div class="px-4 md:px-6 py-4 border-b border-hairline bg-white/80 backdrop-blur sticky top-0 z-10">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Directory</div>
          <div class="text-[17px] font-semibold">Patients</div>
        </div>
        <button id="pt-new" type="button"
          class="h-9 px-3.5 rounded-lg bg-accent hover:bg-accent-hover text-white text-[13px] font-medium transition-colors inline-flex items-center gap-1.5">
          <i class="bi bi-plus-lg text-[12px]" aria-hidden="true"></i>
          New patient
        </button>
      </div>

      <input id="pt-search" type="search" autocomplete="off" placeholder="Search by name or phone"
        class="w-full h-11 px-3 rounded-lg border border-hairline bg-white text-[14px]
               focus:outline-none focus:shadow-focus focus:border-accent" />
    </div>

    <div id="pt-list"></div>

  </div>

  <div id="np-backdrop" hidden class="fixed inset-0 z-40 bg-black/30 backdrop-blur-sm"></div>
  <div id="np-modal" hidden
    class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-50 w-[min(92vw,440px)]
           bg-white rounded-2xl shadow-panel border border-hairline overflow-hidden">
    <div class="px-5 pt-5 pb-3 border-b border-hairline flex items-center justify-between">
      <div class="text-[15px] font-semibold">New patient</div>
      <button id="np-close" type="button" aria-label="Close"
        class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover">
        <i class="bi bi-x-lg text-[13px]" aria-hidden="true"></i>
      </button>
    </div>
    <div class="px-5 py-4 space-y-3">
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1.5">Name</label>
        <input id="np-name" type="text" autocomplete="off"
          class="w-full h-11 px-3 rounded-lg border border-hairline bg-white text-[14px]
                 focus:outline-none focus:shadow-focus focus:border-accent" />
      </div>
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1.5">Phone</label>
        <input id="np-phone" type="tel" inputmode="tel" autocomplete="off"
          class="w-full h-11 px-3 rounded-lg border border-hairline bg-white text-[14px]
                 focus:outline-none focus:shadow-focus focus:border-accent" />
      </div>
    </div>
    <div class="px-5 py-4 border-t border-hairline flex gap-2">
      <button id="np-cancel" type="button"
        class="flex-1 h-11 rounded-lg bg-white hover:bg-surface-hover text-ink border border-hairline text-[13px] font-medium">Cancel</button>
      <button id="np-save" type="button" disabled
        class="flex-1 h-11 rounded-lg bg-accent hover:bg-accent-hover text-white text-[13px] font-medium disabled:opacity-60 disabled:cursor-not-allowed">Save</button>
    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { searchByName, searchByPhone, create as createPatient, findExact } from '../js/patients.js';
    import { showToast } from '../js/lib/toast.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      results: [],
      saving: false
    };

    function esc(s) {
      return String(s == null ? '' : s)
        .split('&').join('&amp;')
        .split('<').join('&lt;')
        .split('>').join('&gt;')
        .split('"').join('&quot;')
        .split("'").join('&#39;');
    }

    function render() {
      const root = $('#pt-list');
      if (!root) return;

      const q = $('#pt-search').value.trim();
      if (q.length < 2) {
        root.innerHTML = `
          <div class="p-10 text-center">
            <div class="text-[14px] text-ink-mute mb-1">Search for a patient.</div>
            <div class="text-[12.5px] text-ink-faint">Type at least 2 characters, or add a new patient.</div>
          </div>`;
        return;
      }

      if (state.results.length === 0) {
        root.innerHTML = `
          <div class="p-10 text-center">
            <div class="text-[14px] text-ink-mute mb-1">No matches.</div>
            <div class="text-[12.5px] text-ink-faint">Try a different spelling, or add a new patient.</div>
          </div>`;
        return;
      }

      root.innerHTML = state.results.map((p) => `
        <div data-pid="${esc(p.id)}"
          class="flex items-center gap-3 px-4 md:px-6 h-[60px] border-b border-hairline hover:bg-surface-hover cursor-pointer">
          <div class="flex-1 min-w-0">
            <div class="text-[14.5px] font-medium truncate">${esc(p.name)}</div>
            <div class="text-[12.5px] text-ink-mute truncate">${esc(p.phone || '')}</div>
          </div>
          <div class="shrink-0 text-ink-faint">
            <i class="bi bi-chevron-right text-[13px]" aria-hidden="true"></i>
          </div>
        </div>`).join('');

      root.querySelectorAll('[data-pid]').forEach((el) => {
        el.addEventListener('click', () => {
          location.href = `/patient?id=${encodeURIComponent(el.getAttribute('data-pid'))}`;
        });
      });
    }

    async function runSearch(q) {
      try {
        const byName = await searchByName(state.clinicId, q, 20);
        const byPhone = /^[0-9+ -]{4,}$/.test(q) ? await searchByPhone(state.clinicId, q) : [];
        const merged = [];
        const seen = new Set();
        for (const p of [...byName, ...byPhone]) {
          if (seen.has(p.id)) continue;
          seen.add(p.id);
          merged.push(p);
        }
        merged.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        state.results = merged;
      } catch (err) {
        console.error('[patients] search failed:', err);
        state.results = [];
      }
      render();
    }

    function wireSearch() {
      let timer = null;
      $('#pt-search').addEventListener('input', (e) => {
        clearTimeout(timer);
        const q = e.target.value.trim();
        if (q.length < 2) { state.results = []; render(); return; }
        timer = setTimeout(() => runSearch(q), 250);
      });
    }

    function openModal() {
      $('#np-backdrop').hidden = false;
      $('#np-modal').hidden = false;
      $('#np-name').value = '';
      $('#np-phone').value = '';
      $('#np-save').disabled = true;
      setTimeout(() => $('#np-name').focus(), 50);
    }

    function closeModal() {
      $('#np-backdrop').hidden = true;
      $('#np-modal').hidden = true;
    }

    function updateSaveState() {
      const name = $('#np-name').value.trim();
      $('#np-save').disabled = !name || state.saving;
    }

    async function saveNew() {
      if (state.saving) return;
      const name = $('#np-name').value.trim();
      const phone = $('#np-phone').value.trim();

      // Duplicate check: exact lowercased-name match in this clinic.
      try {
        const existing = await findExact(state.clinicId, name.toLowerCase());
        if (existing) {
          const proceed = confirm(
            'A patient named "' + existing.name + '" already exists' +
            (existing.phone ? ' (' + existing.phone + ')' : '') +
            '.\n\nCreate a new patient with the same name anyway?\n\n' +
            'Click Cancel to use the existing patient instead.'
          );
          if (!proceed) {
            // Navigate to the existing patient instead.
            location.href = `/patient?id=${encodeURIComponent(existing.id)}`;
            return;
          }
        }
      } catch (err) {
        console.warn('[patients] duplicate check failed, proceeding:', err);
      }

      state.saving = true;
      updateSaveState();
      try {
        const id = await createPatient({ clinicId: state.clinicId, name, phone });
        showToast('Patient added');
        setTimeout(() => { location.href = `/patient?id=${encodeURIComponent(id)}`; }, 400);
      } catch (err) {
        console.error('[patients] create failed:', err);
        showToast('Could not add patient', 'error');
        state.saving = false;
        updateSaveState();
      }
    }

    function wireModal() {
      $('#pt-new').addEventListener('click', openModal);
      $('#np-close').addEventListener('click', closeModal);
      $('#np-cancel').addEventListener('click', closeModal);
      $('#np-backdrop').addEventListener('click', closeModal);
      $('#np-name').addEventListener('input', updateSaveState);
      $('#np-save').addEventListener('click', saveNew);
    }

    (async () => {
      await requireAuth();
      state.clinicId = getActiveClinicId();
      wireSearch();
      wireModal();
      render();
    })();
  </script>
</AppLayout>