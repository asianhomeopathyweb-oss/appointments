---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Book">
  <div class="min-h-[calc(100vh-52px)] md:py-10 md:px-6 bg-[#fafafb]">
    <div class="w-full max-w-[560px] mx-auto bg-white md:rounded-2xl md:shadow-panel md:border md:border-hairline overflow-hidden">

      <!-- Header -->
      <div class="px-5 pt-5 pb-4 border-b border-hairline">
        <div class="flex items-center justify-between mb-1">
          <h1 class="text-[17px] font-semibold">Book appointment</h1>
          <button id="book-cancel" type="button" aria-label="Close"
            class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover">
            <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
          </button>
        </div>
        <div class="text-[12.5px] text-ink-mute">
          <span id="book-clinic">—</span>
          <span class="mx-1">·</span>
          <span id="book-date">—</span>
        </div>
      </div>

      <!-- Patient -->
      <div class="px-5 py-4 border-b border-hairline">
        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">Patient</label>
        <input id="patient-search" type="text" autocomplete="off" placeholder="Search by name or phone"
          class="w-full h-11 px-3 rounded-lg border border-hairline bg-white text-[14px]
                 focus:outline-none focus:shadow-focus focus:border-accent" />
        <div id="patient-results" class="mt-2 rounded-lg border border-hairline bg-white overflow-hidden max-h-[220px] overflow-y-auto"></div>
        <button id="patient-create" type="button"
          class="mt-2 h-8 px-3 rounded-lg text-[12.5px] text-ink-mute hover:bg-surface-hover inline-flex items-center gap-1.5">
          <i class="bi bi-plus-lg text-[12px]" aria-hidden="true"></i>
          Create new patient
        </button>
      </div>

      <!-- Slot -->
      <div class="px-5 py-4 border-b border-hairline">
        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">Time</label>
        <div id="book-slots" class="min-h-[40px]"></div>
      </div>

      <!-- Type + mode -->
      <div class="px-5 py-4 border-b border-hairline grid grid-cols-2 gap-4">
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">Type</label>
          <div class="flex gap-1.5">
            <button type="button" data-type="followup"
              class="h-8 px-3 rounded-lg text-[12.5px] border border-hairline hover:border-accent bg-accent-soft text-accent font-medium">
              Follow-up
            </button>
            <button type="button" data-type="new"
              class="h-8 px-3 rounded-lg text-[12.5px] border border-hairline hover:border-accent">
              New
            </button>
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">Mode</label>
          <div class="flex gap-1.5">
            <button type="button" data-mode="visit"
              class="h-8 px-3 rounded-lg text-[12.5px] border border-hairline hover:border-accent bg-accent-soft text-accent font-medium">
              Visit
            </button>
            <button type="button" data-mode="call"
              class="h-8 px-3 rounded-lg text-[12.5px] border border-hairline hover:border-accent">
              Call
            </button>
          </div>
        </div>
      </div>

      <!-- Warning -->
      <div id="book-warn" hidden
        class="px-5 py-3 bg-[#fff7e6] border-b border-hairline text-[12.5px] text-[#92400e] flex items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill text-[13px] mt-0.5" aria-hidden="true"></i>
        <span></span>
      </div>

      <!-- Summary -->
      <div class="px-5 py-4 bg-[#fafafb]">
        <div class="space-y-1.5 text-[12.5px] text-ink-mute">
          <div class="flex justify-between"><span>Patient</span><span id="summary-patient" class="text-ink font-medium truncate ml-3">—</span></div>
          <div class="flex justify-between"><span>Time</span><span id="summary-slot" class="text-ink font-medium">—</span></div>
          <div class="flex justify-between"><span>Type</span><span id="summary-type" class="text-ink font-medium">—</span></div>
          <div class="flex justify-between"><span>Mode</span><span id="summary-mode" class="text-ink font-medium">—</span></div>
        </div>
      </div>

      <!-- Actions -->
      <div class="px-5 py-4 border-t border-hairline">
        <button id="book-save" type="button" disabled
          class="w-full h-11 rounded-lg bg-accent hover:bg-accent-hover text-white text-[13px] font-medium
                 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
          Book appointment
        </button>
      </div>

    </div>
  </div>

  <script>
    import { requireAuth } from "../js/lib/auth-guards.js";
    import { startBookingFlow } from "../js/booking-flow.js";

    (async () => {
      await requireAuth();
      await startBookingFlow();
    })();
  </script>
</AppLayout>
