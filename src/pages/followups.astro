---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Follow-ups">
  <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 py-6 flex flex-col h-full bg-surface">

    <!-- Premium Floating Date Strip -->
    <div class="flex items-center gap-2 md:gap-3 mb-6 w-full">
      <button id="fu-prev" class="w-9 h-9 md:w-10 md:h-10 shrink-0 grid place-items-center rounded-full bg-white border border-hairline shadow-sm hover:border-accent hover:text-accent text-ink-mute transition-all">
        <i class="bi bi-chevron-left text-[14px] md:text-[16px]"></i>
      </button>

      <!-- The Strip Container -->
      <div id="fu-strip" class="flex-1 flex gap-1 md:gap-2 bg-white border border-hairline p-1 md:p-1.5 rounded-2xl shadow-sm overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <!-- Filled by JS -->
      </div>

      <button id="fu-next" class="w-9 h-9 md:w-10 md:h-10 shrink-0 grid place-items-center rounded-full bg-white border border-hairline shadow-sm hover:border-accent hover:text-accent text-ink-mute transition-all">
        <i class="bi bi-chevron-right text-[14px] md:text-[16px]"></i>
      </button>
    </div>

    <!-- Header Info -->
    <div class="flex items-center justify-between mb-4 px-1 md:px-2">
      <div class="flex items-center gap-3">
        <div class="text-[18px] md:text-[22px] font-bold text-ink tracking-tight">
          <span id="fu-date">—</span>
        </div>
        <div class="text-[12px] md:text-[13px] font-medium text-ink-faint px-3 py-1 bg-surface-hover rounded-full" id="fu-sub">—</div>
      </div>
      <button id="fu-today" class="text-[12px] md:text-[13px] font-bold text-accent hover:underline hidden">
        Go to Today
      </button>
    </div>

    <!-- List Container -->
    <div class="flex-1 overflow-y-auto bg-white rounded-2xl shadow-sm border border-hairline">
      <div id="fu-list" class="divide-y divide-hairline">
        <!-- Filled by JS -->
      </div>
    </div>

  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { getActiveClinicId, getActiveClinic } from '../js/lib/clinic-context.js';
    import { listForDate, listDue } from '../js/followups.js';
    import { todayISO, addDays, fmtDate, fmtDayShort, isToday, isoToDate } from '../js/date-utils.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      clinic: null,
      dateISO: todayISO(),
      items: [],
      markers: new Set()
    };

    function esc(s) {
      return String(s == null ? '' : s)
        .split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;')
        .split('"').join('&quot;').split("'").join('&#39;');
    }

    function renderHeader() {
      const dateEl = $('#fu-date');
      const clinicEl = $('#fu-clinic');
      const subEl = $('#fu-sub');
      const todayBtn = $('#fu-today');

      if (dateEl) dateEl.textContent = fmtDate(state.dateISO);
      if (clinicEl && state.clinic) clinicEl.textContent = state.clinic.name;
      if (subEl) subEl.textContent = state.items.length === 0 ? 'No follow-ups' : `${state.items.length} follow-up${state.items.length === 1 ? '' : 's'}`;
      if (todayBtn) todayBtn.hidden = isToday(state.dateISO);
    }

    function renderStrip() {
      const root = $('#fu-strip');
      if (!root) return;
      
      const days = [];
      // Start 3 days before the selected date
      for (let i = 0; i < 7; i++) days.push(addDays(state.dateISO, i - 3));

      root.innerHTML = days.map((iso) => {
        const selected = iso === state.dateISO;
        const today = isToday(iso);
        const has = state.markers.has(iso);
        const d = isoToDate(iso);
        const dayName = fmtDayShort(iso);
        const num = d.getDate();

        const cls = selected
          ? 'bg-ink text-white shadow-md'
          : today
            ? 'bg-accent-soft text-accent border border-accent/30'
            : 'bg-transparent text-ink-mute hover:bg-surface-hover hover:text-ink';

        return `
          <button type="button" data-day="${iso}"
            class="flex-1 flex flex-col items-center justify-center min-w-[50px] h-[56px] rounded-xl transition-all ${cls}">
            <span class="text-[9px] font-bold tracking-widest uppercase opacity-70">${esc(dayName)}</span>
            <span class="text-[16px] font-bold tnum leading-none mt-1">${num}</span>
            <span class="block w-1 h-1 rounded-full mt-0.5 ${has ? (selected ? 'bg-white' : 'bg-accent') : 'bg-transparent'}"></span>
          </button>`;
      }).join('');

      root.querySelectorAll('[data-day]').forEach((el) => {
        el.addEventListener('click', () => goDate(el.getAttribute('data-day')));
      });
    }

    function renderList() {
      const root = $('#fu-list');
      if (!root) return;

      if (state.items.length === 0) {
        root.innerHTML = `
          <div class="p-10 text-center">
            <div class="text-[14px] text-ink-mute mb-1">No follow-ups due on this date.</div>
            <div class="text-[12.5px] text-ink-faint">Try another day using the strip above.</div>
          </div>`;
        return;
      }

      root.innerHTML = state.items.map((f) => `
        <div data-fu-id="${esc(f.id)}"
          class="flex items-center gap-4 px-4 md:px-6 h-[64px] hover:bg-surface-hover cursor-pointer transition-colors">
          <div class="flex-1 min-w-0">
            <div class="text-[14.5px] font-semibold text-ink truncate">${esc(f.patientName || 'Patient')}</div>
            <div class="text-[12.5px] text-ink-mute truncate">
              ${esc(f.patientPhone || '')}
              ${f.seenOn ? `<span class="mx-1 text-ink-faint">·</span>seen ${esc(fmtDate(f.seenOn))}` : ''}
            </div>
          </div>
          <div class="shrink-0 text-ink-faint">
            <i class="bi bi-chevron-right text-[14px]"></i>
          </div>
        </div>`).join('');

      root.querySelectorAll('[data-fu-id]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-fu-id');
          location.href = `/followup?id=${encodeURIComponent(id)}`;
        });
      });
    }

    async function load() {
      try {
        state.items = await listForDate(state.clinicId, state.dateISO);
      } catch (err) {
        state.items = [];
      }
      await loadMarkers();
      renderHeader();
      renderStrip();
      renderList();
    }

    async function loadMarkers() {
      try {
        const all = await listDue(state.clinicId, addDays(state.dateISO, 90));
        state.markers = new Set(all.map((x) => x.dueDate));
      } catch {
        state.markers = new Set();
      }
    }

    function goDate(iso) {
      state.dateISO = iso;
      const url = new URL(location.href);
      url.searchParams.set('date', iso);
      history.replaceState(null, '', url);
      load();
    }

    function wireNav() {
      const prev = $('#fu-prev');
      const next = $('#fu-next');
      const today = $('#fu-today');

      if (prev) prev.addEventListener('click', () => goDate(addDays(state.dateISO, -1)));
      if (next) next.addEventListener('click', () => goDate(addDays(state.dateISO, 1)));
      if (today) today.addEventListener('click', () => goDate(todayISO()));
    }

    (async () => {
      await requireAuth();
      state.clinicId = getActiveClinicId();
      state.clinic = await getActiveClinic();

      const p = new URLSearchParams(location.search);
      const d = p.get('date');
      if (d) state.dateISO = d;

      wireNav();
      await load();
    })();
  </script>
</AppLayout>