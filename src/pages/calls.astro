---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Calls">
  <div class="max-w-[860px]">

    <div class="px-4 md:px-6 py-4 border-b border-hairline bg-white/80 backdrop-blur sticky top-0 z-10 flex items-center justify-between">
      <div>
        <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Phone</div>
        <div class="flex items-baseline gap-2">
          <div class="text-[17px] font-semibold">Calls</div>
          <div id="calls-sub" class="text-[12.5px] text-ink-mute"></div>
        </div>
      </div>
      <button id="calls-new" type="button"
        class="h-9 px-3.5 rounded-lg bg-accent hover:bg-accent-hover text-white text-[13px] font-medium transition-colors inline-flex items-center gap-1.5">
        <i class="bi bi-plus-lg text-[12px]" aria-hidden="true"></i>
        New call
      </button>
    </div>

    <div id="calls-list"></div>

  </div>

  <!-- New call modal -->
  <div id="newcall-backdrop" hidden
    class="fixed inset-0 z-40 bg-black/30 backdrop-blur-sm"></div>
  <div id="newcall-modal" hidden
    class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-50 w-[min(92vw,480px)]
           bg-white rounded-2xl shadow-panel border border-hairline overflow-hidden">
    <div class="px-5 pt-5 pb-3 border-b border-hairline flex items-center justify-between">
      <div class="text-[15px] font-semibold">Log a call</div>
      <button id="newcall-close" type="button" aria-label="Close"
        class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover">
        <i class="bi bi-x-lg text-[13px]" aria-hidden="true"></i>
      </button>
    </div>
    <div class="px-5 py-4 space-y-3">
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1.5">Patient</label>
        <input id="nc-search" type="text" autocomplete="off" placeholder="Search by name or phone"
          class="w-full h-11 px-3 rounded-lg border border-hairline bg-white text-[14px]
                 focus:outline-none focus:shadow-focus focus:border-accent" />
        <div id="nc-results" class="mt-2 rounded-lg border border-hairline bg-white overflow-hidden max-h-[180px] overflow-y-auto"></div>
        <div id="nc-chosen" hidden class="mt-2 px-3 py-2 rounded-lg bg-accent-soft text-accent text-[13px]"></div>
      </div>
      <div>
        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1.5">Reason</label>
        <textarea id="nc-reason" rows="3" placeholder="What did they call about?"
          class="w-full px-3 py-2 rounded-lg border border-hairline bg-white text-[14px] resize-none
                 focus:outline-none focus:shadow-focus focus:border-accent"></textarea>
      </div>
    </div>
    <div class="px-5 py-4 border-t border-hairline flex gap-2">
      <button id="newcall-cancel" type="button"
        class="flex-1 h-11 rounded-lg bg-white hover:bg-surface-hover text-ink border border-hairline text-[13px] font-medium">Cancel</button>
      <button id="newcall-save" type="button" disabled
        class="flex-1 h-11 rounded-lg bg-accent hover:bg-accent-hover text-white text-[13px] font-medium disabled:opacity-60 disabled:cursor-not-allowed">Log call</button>
    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { listPending, create as createCall } from '../js/calls.js';
    import { searchByName, searchByPhone } from '../js/patients.js';
    import { showToast } from '../js/lib/toast.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      pending: [],
      newCallPatient: null,
      saving: false
    };

    function esc(s) {
      return String(s == null ? '' : s)
        .split('&').join('&amp;')
        .split('<').join('&lt;')
        .split('>').join('&gt;')
        .split('"').join('&quot;')
        .split("'").join('&#39;');
    }

    // ---------- list ----------
    function render() {
      const root = $('#calls-list');
      const sub = $('#calls-sub');
      if (sub) sub.textContent = state.pending.length === 0 ? 'Nothing pending' : `${state.pending.length} pending`;

      if (state.pending.length === 0) {
        root.innerHTML = `
          <div class="p-10 text-center">
            <div class="text-[14px] text-ink-mute mb-1">No pending calls.</div>
            <div class="text-[12.5px] text-ink-faint">Tap "New call" when a patient calls in.</div>
          </div>`;
        return;
      }

      root.innerHTML = `
        <div class="px-4 md:px-6 pt-5 pb-2">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint">Pending · ${state.pending.length}</div>
        </div>
        ${state.pending.map((c) => `
          <div data-call-id="${esc(c.id)}"
            class="flex items-center gap-3 px-4 md:px-6 h-[64px] border-b border-hairline hover:bg-surface-hover cursor-pointer">
            <div class="flex-1 min-w-0">
              <div class="text-[14.5px] font-medium truncate">${esc(c.patientName || 'Patient')}</div>
              <div class="text-[12.5px] text-ink-mute truncate">${esc(c.reason || c.patientPhone || '')}</div>
            </div>
            <div class="shrink-0 text-ink-faint">
              <i class="bi bi-chevron-right text-[13px]" aria-hidden="true"></i>
            </div>
          </div>`).join('')}`;

      root.querySelectorAll('[data-call-id]').forEach((el) => {
        el.addEventListener('click', () => {
          location.href = `/call?id=${encodeURIComponent(el.getAttribute('data-call-id'))}`;
        });
      });
    }

    async function load() {
      try {
        state.pending = await listPending(state.clinicId);
      } catch (err) {
        console.error('[calls] load failed:', err);
        state.pending = [];
      }
      render();
    }

    // ---------- new call modal ----------
    function openModal() {
      $('#newcall-backdrop').hidden = false;
      $('#newcall-modal').hidden = false;
      state.newCallPatient = null;
      $('#nc-search').value = '';
      $('#nc-reason').value = '';
      $('#nc-results').innerHTML = '';
      $('#nc-chosen').hidden = true;
      $('#newcall-save').disabled = true;
      setTimeout(() => $('#nc-search').focus(), 50);
    }

    function closeModal() {
      $('#newcall-backdrop').hidden = true;
      $('#newcall-modal').hidden = true;
    }

    function wireModal() {
      $('#calls-new').addEventListener('click', openModal);
      $('#newcall-close').addEventListener('click', closeModal);
      $('#newcall-cancel').addEventListener('click', closeModal);
      $('#newcall-backdrop').addEventListener('click', closeModal);

      let timer = null;
      $('#nc-search').addEventListener('input', (e) => {
        clearTimeout(timer);
        const q = e.target.value.trim();
        if (q.length < 2) { $('#nc-results').innerHTML = ''; return; }
        timer = setTimeout(() => runSearch(q), 250);
      });

      $('#nc-results').addEventListener('click', (e) => {
        const row = e.target.closest('[data-pid]');
        if (!row) return;
        state.newCallPatient = {
          id: row.getAttribute('data-pid'),
          name: row.getAttribute('data-pname'),
          phone: row.getAttribute('data-pphone')
        };
        $('#nc-search').value = state.newCallPatient.name;
        $('#nc-results').innerHTML = '';
        const chosen = $('#nc-chosen');
        chosen.textContent = 'Selected: ' + state.newCallPatient.name;
        chosen.hidden = false;
        updateSaveState();
      });

      $('#nc-reason').addEventListener('input', updateSaveState);
      $('#newcall-save').addEventListener('click', saveCall);
    }

    function updateSaveState() {
      const ok = state.newCallPatient && $('#nc-reason').value.trim().length > 0 && !state.saving;
      $('#newcall-save').disabled = !ok;
    }

    async function runSearch(q) {
      try {
        const byName = await searchByName(state.clinicId, q, 8);
        const byPhone = /^[0-9+ -]{4,}$/.test(q) ? await searchByPhone(state.clinicId, q) : [];
        const merged = [];
        const seen = new Set();
        for (const p of [...byName, ...byPhone]) {
          if (seen.has(p.id)) continue;
          seen.add(p.id);
          merged.push(p);
        }
        const root = $('#nc-results');
        if (merged.length === 0) {
          root.innerHTML = `<div class="px-3 py-2 text-[12.5px] text-ink-faint">No matches</div>`;
          return;
        }
        root.innerHTML = merged.map((p) => `
          <div data-pid="${p.id}" data-pname="${esc(p.name)}" data-pphone="${esc(p.phone || '')}"
            class="px-3 py-2 hover:bg-surface-hover cursor-pointer border-b border-hairline last:border-b-0">
            <div class="text-[14px] font-medium">${esc(p.name)}</div>
            ${p.phone ? `<div class="text-[12px] text-ink-mute">${esc(p.phone)}</div>` : ''}
          </div>`).join('');
      } catch (err) {
        console.error('[calls] search failed:', err);
      }
    }

    async function saveCall() {
      if (state.saving) return;
      state.saving = true;
      try {
        await createCall({
          clinicId: state.clinicId,
          patientId: state.newCallPatient.id,
          patientName: state.newCallPatient.name,
          patientPhone: state.newCallPatient.phone,
          reason: $('#nc-reason').value.trim()
        });
        showToast('Call logged');
        closeModal();
        await load();
      } catch (err) {
        console.error('[calls] save failed:', err);
        showToast('Could not log call', 'error');
      } finally {
        state.saving = false;
        updateSaveState();
      }
    }

    // ---------- start ----------
    (async () => {
      await requireAuth();
      state.clinicId = getActiveClinicId();
      wireModal();
      await load();
    })();
  </script>
</AppLayout>