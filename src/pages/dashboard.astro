---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Dashboard">
  <div class="w-full max-w-[1400px] mx-auto px-0 md:px-8 py-0 md:py-4 flex flex-col h-[calc(100vh-52px)] md:h-full bg-surface md:overflow-hidden overflow-y-auto">

    <!-- Header (Compact) -->
    <div class="flex flex-row items-center justify-between gap-4 mb-3 shrink-0 px-4 md:px-0 pt-3 md:pt-0">
      <div class="text-[22px] md:text-[24px] font-bold text-ink tracking-tight">Dashboard</div>
      
      <!-- Central Filter -->
      <div class="relative w-auto">
        <select id="dash-filter" class="w-[140px] md:w-[180px] h-9 md:h-10 px-3 md:px-4 rounded-xl border border-hairline bg-white text-[12px] md:text-[13px] font-semibold text-ink outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all shadow-sm appearance-none cursor-pointer">
          <option value="today">Today</option>
          <option value="yesterday">Yesterday</option>
          <option value="tomorrow">Tomorrow</option>
          <option value="this_week">This Week</option>
          <option value="last_week">Last Week</option>
          <option value="last_7">Last 7 Days</option>
          <option value="last_15">Last 15 Days</option>
          <option value="last_21">Last 21 Days</option>
          <option value="this_month">This Month</option>
          <option value="last_month">Last Month</option>
          <option value="this_quarter">This Quarter</option>
          <option value="last_quarter">Last Quarter</option>
          <option value="this_year">This Year</option>
          <option value="last_year">Last Year</option>
          <option value="last_365">Last 365 Days</option>
        </select>
        <i class="bi bi-chevron-down absolute right-2 md:right-3 top-1/2 -translate-y-1/2 text-ink-mute text-[10px] md:text-[12px] pointer-events-none"></i>
      </div>
    </div>

    <!-- Loading Overlay -->
    <div id="dash-loading" class="hidden fixed inset-0 bg-surface/80 backdrop-blur-sm z-50 flex items-center justify-center">
      <div class="w-10 h-10 border-4 border-accent/20 border-t-accent rounded-full animate-spin"></div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 md:gap-4 flex-1 min-h-0">
      
      <!-- LEFT: Appointments & Calls Lists -->
      <div class="lg:col-span-8 flex flex-col md:flex-row gap-0 md:gap-4 md:overflow-hidden h-full">
        
        <!-- Appointments Column (Takes available space) -->
        <div class="flex-1 flex flex-col bg-transparent lg:bg-white lg:rounded-2xl lg:shadow-sm lg:border lg:border-hairline md:overflow-hidden h-full">
          <div class="hidden lg:flex border-b border-hairline bg-surface-hover/30 shrink-0">
            <div class="flex-1 py-2.5 text-[11px] font-bold tracking-widest text-ink uppercase text-center">Appointments</div>
          </div>
          
          <!-- Appointment List -->
          <div id="dash-list" class="flex-1 md:overflow-y-auto divide-y divide-hairline lg:divide-hairline/50 bg-white lg:bg-transparent"></div>
          
          <!-- Mobile-only Calls Section -->
          <div class="md:hidden mt-2">
            <div class="px-4 py-2 text-[11px] font-bold uppercase tracking-widest text-ink-mute bg-surface-hover border-y border-hairline">
              Pending Calls
            </div>
            <div id="dash-mobile-calls" class="bg-white divide-y divide-hairline"></div>
          </div>
        </div>

        <!-- Desktop Calls Column -->
        <div class="hidden md:flex w-[300px] shrink-0 flex-col bg-white rounded-2xl shadow-sm border border-hairline overflow-hidden h-full">
          <div class="border-b border-hairline bg-surface-hover/30 shrink-0">
            <div class="py-2.5 text-[11px] font-bold tracking-widest text-ink uppercase text-center">Calls</div>
          </div>
          <div id="dash-calls-desktop" class="flex-1 overflow-y-auto divide-y divide-hairline/50"></div>
        </div>

      </div>

      <!-- RIGHT: Metrics & Charts (Hidden on Mobile) -->
      <div class="hidden lg:flex lg:col-span-4 flex-col gap-3 md:gap-4 overflow-y-auto pr-1 pb-4">
        
        <!-- Metrics Grid -->
        <div class="grid grid-cols-2 gap-2 md:gap-3">
          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4 flex flex-col justify-between">
            <div class="text-[10px] font-bold tracking-widest text-ink-faint uppercase mb-2">Total Appts</div>
            <div id="stat-total" class="text-[26px] font-extrabold text-ink tracking-tight tnum leading-none">—</div>
          </div>
          
          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4 flex flex-col justify-between">
            <div class="text-[10px] font-bold tracking-widest text-ink-faint uppercase mb-2">Seen</div>
            <div id="stat-seen" class="text-[26px] font-extrabold text-emerald-600 tracking-tight tnum leading-none">—</div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4 flex flex-col justify-between">
            <div class="text-[10px] font-bold tracking-widest text-ink-faint uppercase mb-2">New Pts</div>
            <div id="stat-new" class="text-[26px] font-extrabold text-blue-600 tracking-tight tnum leading-none">—</div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute inset-0 bg-orange-50/50"></div>
            <div class="relative z-10">
              <div class="text-[10px] font-bold tracking-widest text-orange-600 uppercase mb-2">Follow-ups</div>
              <div id="stat-fu" class="text-[26px] font-extrabold text-orange-600 tracking-tight tnum leading-none">—</div>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute inset-0 bg-red-50/50"></div>
            <div class="relative z-10">
              <div class="text-[10px] font-bold tracking-widest text-red-600 uppercase mb-2 flex items-center gap-1">
                <i class="bi bi-exclamation-circle-fill"></i> Unpaid
              </div>
              <div id="stat-unpaid" class="text-[26px] font-extrabold text-red-600 tracking-tight tnum leading-none">—</div>
            </div>
          </div>

          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute inset-0 bg-pink-50/50"></div>
            <div class="relative z-10">
              <div class="text-[10px] font-bold tracking-widest text-pink-600 uppercase mb-2">Calls</div>
              <div id="stat-calls" class="text-[26px] font-extrabold text-pink-600 tracking-tight tnum leading-none">—</div>
              <div id="stat-calls-sub" class="text-[10px] font-medium text-pink-500/80 mt-1 tnum">—</div>
            </div>
          </div>
        </div>

        <!-- Last 7 Days Trend -->
        <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4">
          <div class="text-[11px] font-bold tracking-widest text-ink-mute uppercase mb-4">Last 7 Days</div>
          <div id="dash-trend" class="h-[100px] flex items-end justify-between gap-1 md:gap-2">
            <!-- Filled by JS -->
          </div>
        </div>

        <!-- New vs Returning -->
        <div class="bg-white rounded-2xl shadow-sm border border-hairline p-4">
          <div class="text-[11px] font-bold tracking-widest text-ink-mute uppercase mb-4">Patient Mix</div>
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between text-[13px]">
              <span class="text-ink-mute font-medium">New Patients</span>
              <span id="mix-new" class="font-bold text-ink tnum">—</span>
            </div>
            <div class="w-full h-2.5 bg-surface-hover rounded-full overflow-hidden flex">
              <div id="mix-bar-new" class="h-full bg-blue-500 transition-all duration-500" style="width: 0%"></div>
              <div id="mix-bar-returning" class="h-full bg-accent transition-all duration-500" style="width: 0%"></div>
            </div>
            <div class="flex items-center justify-between text-[13px]">
              <span class="text-ink-mute font-medium">Returning</span>
              <span id="mix-returning" class="font-bold text-ink tnum">—</span>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script>
    import { requireAuth, isAdmin } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { todayISO, addDays, fmtDate, fmtSlot, isoToDate } from '../js/date-utils.js';
    import { esc } from '../js/lib/format.js';
    import { collection, query, where, getDocs } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js';
    import { db } from '../js/lib/firebase-init.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      appointments: [],
      followUps: [],
      calls: [],           // Problem calls
      callAppts: [],       // Scheduled call-mode appointments
      currentRange: { start: '', end: '', label: 'Today' }
    };

    function getDateRange(filterVal) {
      const today = new Date();
      const y = today.getFullYear();
      const m = today.getMonth();
      const d = today.getDate();

      const fmt = (dateObj) => {
        const yy = dateObj.getFullYear();
        const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
        const dd = String(dateObj.getDate()).padStart(2, '0');
        return `${yy}-${mm}-${dd}`;
      };

      const startOfWeek = new Date(today);
      startOfWeek.setDate(d - today.getDay());

      switch(filterVal) {
        case 'today': return { start: fmt(today), end: fmt(today), label: 'Today' };
        case 'yesterday': { const yd = new Date(today); yd.setDate(d - 1); return { start: fmt(yd), end: fmt(yd), label: 'Yesterday' }; }
        case 'tomorrow': { const tm = new Date(today); tm.setDate(d + 1); return { start: fmt(tm), end: fmt(tm), label: 'Tomorrow' }; }
        case 'this_week': { const end = new Date(startOfWeek); end.setDate(startOfWeek.getDate() + 6); return { start: fmt(startOfWeek), end: fmt(end), label: 'This Week' }; }
        case 'last_week': { const start = new Date(startOfWeek); start.setDate(start.getDate() - 7); const end = new Date(start); end.setDate(start.getDate() + 6); return { start: fmt(start), end: fmt(end), label: 'Last Week' }; }
        case 'last_7': { const start = new Date(today); start.setDate(d - 6); return { start: fmt(start), end: fmt(today), label: 'Last 7 Days' }; }
        case 'last_15': { const start = new Date(today); start.setDate(d - 14); return { start: fmt(start), end: fmt(today), label: 'Last 15 Days' }; }
        case 'last_21': { const start = new Date(today); start.setDate(d - 20); return { start: fmt(start), end: fmt(today), label: 'Last 21 Days' }; }
        case 'this_month': { const start = new Date(y, m, 1); const end = new Date(y, m + 1, 0); return { start: fmt(start), end: fmt(end), label: 'This Month' }; }
        case 'last_month': { const start = new Date(y, m - 1, 1); const end = new Date(y, m, 0); return { start: fmt(start), end: fmt(end), label: 'Last Month' }; }
        case 'this_quarter': { const q = Math.floor(m / 3); const start = new Date(y, q * 3, 1); const end = new Date(y, (q + 1) * 3, 0); return { start: fmt(start), end: fmt(end), label: 'This Quarter' }; }
        case 'last_quarter': { const q = Math.floor(m / 3) - 1; const start = new Date(y, q * 3, 1); const end = new Date(y, (q + 1) * 3, 0); return { start: fmt(start), end: fmt(end), label: 'Last Quarter' }; }
        case 'this_year': return { start: `${y}-01-01`, end: `${y}-12-31`, label: 'This Year' };
        case 'last_year': return { start: `${y-1}-01-01`, end: `${y-1}-12-31`, label: 'Last Year' };
        case 'last_365': { const start = new Date(today); start.setDate(d - 364); return { start: fmt(start), end: fmt(today), label: 'Last 365 Days' }; }
        default: return { start: fmt(today), end: fmt(today), label: 'Today' };
      }
    }

    async function loadData() {
      $('#dash-loading').classList.remove('hidden');
      try {
        const cId = state.clinicId;
        // patients query removed — unused in this dashboard
        const [appts, fus, cls] = await Promise.all([
          getDocs(query(collection(db, 'appointments'), where('clinicId', '==', cId))),
          getDocs(query(collection(db, 'followUps'), where('clinicId', '==', cId))),
          getDocs(query(collection(db, 'calls'), where('clinicId', '==', cId)))
        ]);

        const allAppts = appts.docs.map(d => ({ id: d.id, ...d.data() })).filter(x => x.deleted !== true);
        state.appointments = allAppts;
        state.callAppts = allAppts.filter(x => x.mode === 'call');

        state.followUps = fus.docs.map(d => ({ id: d.id, ...d.data() })).filter(x => x.deleted !== true);
        state.calls = cls.docs.map(d => ({ id: d.id, ...d.data() })).filter(x => x.deleted !== true);
      } catch (err) {
        console.error(err);
      } finally {
        $('#dash-loading').classList.add('hidden');
      }
    }

    function renderAppointmentList() {
      const list = $('#dash-list');
      const { start, end } = state.currentRange;

      const rangeAppts = state.appointments.filter(a => a.date >= start && a.date <= end);

      if (rangeAppts.length === 0) {
        list.innerHTML = `<div class="p-8 text-center text-ink-faint text-[13px]">No appointments in this range.</div>`;
        return;
      }

      rangeAppts.sort((a, b) => (a.date + a.slot).localeCompare(b.date + b.slot));
      list.innerHTML = rangeAppts.map(a => `
        <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-surface-hover transition-colors border-b border-hairline/50 last:border-b-0 cursor-pointer" onclick="window.location.href='/appointment?id=${a.id}'">
          <div class="w-[70px] shrink-0">
            <div class="text-[12px] font-bold text-ink tnum">${fmtSlot(a.slot)}</div>
            <div class="text-[10px] text-ink-faint tnum">${fmtDate(a.date)}</div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-[13.5px] font-semibold text-ink truncate">${esc(a.patientName)}</div>
            <div class="flex gap-1 mt-0.5">
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase ${a.mode === 'call' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'}">${a.mode || 'Visit'}</span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase ${a.status === 'seen' ? 'bg-emerald-100 text-emerald-700' : 'bg-surface-hover text-ink-mute'}">${a.status}</span>
            </div>
          </div>
        </div>
      `).join('');
    }

    function renderCallRows(targetEl, merged) {
      if (merged.length === 0) {
        targetEl.innerHTML = `<div class="p-8 text-center text-ink-faint text-[13px]">No calls in this range.</div>`;
        return;
      }

      targetEl.innerHTML = merged.map(item => {
        const isProblem = item._type === 'problem';

        let timeStr = '—', dateStr = '';
        if (isProblem) {
          // Defensive: legacy docs may lack createdAt
          if (item.createdAt && typeof item.createdAt.seconds === 'number') {
            const cDate = new Date(item.createdAt.seconds * 1000);
            timeStr = `${String(cDate.getHours()).padStart(2,'0')}:${String(cDate.getMinutes()).padStart(2,'0')}`;
            dateStr = `${String(cDate.getDate()).padStart(2,'0')} ${['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][cDate.getMonth()]}`;
          }
        } else {
          timeStr = fmtSlot(item.slot);
          dateStr = fmtDate(item.date);
        }

        const url = isProblem ? `/call?id=${item.id}` : `/appointment?id=${item.id}`;

        return `
          <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-surface-hover transition-colors border-b border-hairline/50 last:border-b-0 cursor-pointer" onclick="window.location.href='${url}'">
            <div class="w-[70px] shrink-0">
              <div class="text-[12px] font-bold text-ink tnum">${timeStr}</div>
              <div class="text-[10px] text-ink-faint tnum">${dateStr}</div>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-[13.5px] font-semibold text-ink truncate">${esc(item.patientName)}</div>
              <div class="text-[11px] text-ink-mute truncate">${esc(isProblem ? item.reason || 'No reason' : 'Scheduled Call')}</div>
            </div>
            <div class="shrink-0">
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase ${
                isProblem ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'
              }">${isProblem ? 'Problem' : 'Scheduled'}</span>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderCallsFiltered() {
      const targetEl = $('#dash-calls-desktop');
      if (!targetEl) return;

      const { start, end } = state.currentRange;

      // Problem calls in range, pending only
      const rangeCalls = state.calls.filter(c => {
        if (!c.createdAt || typeof c.createdAt.seconds !== 'number') return false;
        if (c.status !== 'pending') return false;
        const cDate = new Date(c.createdAt.seconds * 1000);
        const iso = cDate.toISOString().split('T')[0];
        return iso >= start && iso <= end;
      }).map(c => ({ ...c, _type: 'problem' }));

      // Scheduled call-mode appts in range, booked only (matches mobile)
      const rangeCallAppts = state.callAppts.filter(a =>
        a.date >= start && a.date <= end && a.status === 'booked'
      ).map(a => ({ ...a, _type: 'scheduled' }));

      const merged = [...rangeCalls, ...rangeCallAppts];

      if (merged.length === 0) {
        targetEl.innerHTML = `<div class="p-8 text-center text-ink-faint text-[13px]">No pending calls.</div>`;
        return;
      }

      merged.sort((a, b) => {
        const aTime = a.createdAt?.seconds || (a.date ? new Date(a.date).getTime()/1000 : 0);
        const bTime = b.createdAt?.seconds || (b.date ? new Date(b.date).getTime()/1000 : 0);
        return bTime - aTime;
      });

      renderCallRows(targetEl, merged);
    }

    function renderCallsMobile() {
      const targetEl = $('#dash-mobile-calls');
      if (!targetEl) return;

      const pendingProblems = state.calls
        .filter(c => c.status === 'pending')
        .map(c => ({ ...c, _type: 'problem' }));

      const pendingScheduled = state.callAppts
        .filter(a => a.status === 'booked' && a.date >= todayISO())
        .map(a => ({ ...a, _type: 'scheduled' }));

      const merged = [...pendingProblems, ...pendingScheduled];

      if (merged.length === 0) {
        targetEl.innerHTML = `<div class="p-8 text-center text-ink-faint text-[13px]">No pending calls.</div>`;
        return;
      }

      merged.sort((a, b) => {
        const aTime = a.createdAt?.seconds || (a.date ? new Date(a.date).getTime()/1000 : 0);
        const bTime = b.createdAt?.seconds || (b.date ? new Date(b.date).getTime()/1000 : 0);
        return bTime - aTime;
      });

      renderCallRows(targetEl, merged);
    }

    function render() {
      const { start, end } = state.currentRange;
      const today = todayISO();

      // ---- 1. Metrics ----
      const rangeAppts = state.appointments.filter(a => a.date >= start && a.date <= end);

      const total = rangeAppts.length;
      const seen = rangeAppts.filter(a => a.status === 'seen').length;
      const newPts = rangeAppts.filter(a => a.type === 'new').length;

      const pendingFu = state.followUps.filter(f => f.dueDate >= start && f.dueDate <= end && f.status === 'pending').length;

      // Unpaid: seen but no Invoice / No Bill tag
      const unpaid = rangeAppts.filter(a =>
        a.status === 'seen' &&
        !(a.notes && (a.notes.includes('Invoice:') || a.notes.includes('[No Bill]')))
      ).length;

      // Calls split
      const problemCallsInRange = state.calls.filter(c => {
        if (!c.createdAt || typeof c.createdAt.seconds !== 'number') return false;
        if (c.status !== 'pending') return false;
        const cDate = new Date(c.createdAt.seconds * 1000);
        const iso = cDate.toISOString().split('T')[0];
        return iso >= start && iso <= end;
      }).length;

      const scheduledCallsInRange = state.callAppts.filter(a =>
        a.date >= start && a.date <= end && a.status === 'booked'
      ).length;

      const totalCalls = problemCallsInRange + scheduledCallsInRange;

      $('#stat-total').textContent = total;
      $('#stat-seen').textContent = seen;
      $('#stat-new').textContent = newPts;
      $('#stat-fu').textContent = pendingFu;
      $('#stat-unpaid').textContent = unpaid;
      $('#stat-calls').textContent = totalCalls;
      $('#stat-calls-sub').textContent =
        totalCalls === 0 ? 'none pending'
        : `${problemCallsInRange} problem · ${scheduledCallsInRange} scheduled`;

      // ---- 2. Lists ----
      renderAppointmentList();
      renderCallsFiltered();
      renderCallsMobile();

      // ---- 3. Last 7 Days Trend (always last 7, regardless of filter) ----
      const trendEl = $('#dash-trend');
      const last7 = [];
      for (let i = 6; i >= 0; i--) {
        const d = addDays(today, -i);
        const count = state.appointments.filter(a => a.date === d).length;
        last7.push({ date: d, count });
      }
      const maxTrend = Math.max(...last7.map(x => x.count), 1);

      trendEl.innerHTML = last7.map(t => {
        const h = (t.count / maxTrend) * 100;
        const day = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][isoToDate(t.date).getDay()];
        return `
          <div class="flex-1 flex flex-col items-center justify-end h-full gap-1 group">
            <div class="text-[10px] font-bold text-ink-mute opacity-0 group-hover:opacity-100 transition-opacity mb-1">${t.count}</div>
            <div class="w-full bg-accent/20 rounded-t-sm group-hover:bg-accent transition-colors" style="height: ${h}%; min-height: ${t.count > 0 ? '4px' : '0'};"></div>
            <div class="text-[10px] font-medium text-ink-faint">${day}</div>
          </div>`;
      }).join('');

      // ---- 4. New vs Returning Mix ----
      let newCount = 0;
      let returningCount = 0;

      const uniquePatients = new Set(rangeAppts.map(a => a.patientId).filter(Boolean));
      uniquePatients.forEach(pId => {
        const apptsForP = rangeAppts.filter(a => a.patientId === pId);
        const isNew = apptsForP.some(a => a.type === 'new');
        if (isNew) newCount++;
        else returningCount++;
      });

      const totalUnique = newCount + returningCount || 1;
      const newPct = Math.round((newCount / totalUnique) * 100);
      const retPct = 100 - newPct;

      $('#mix-new').textContent = newCount;
      $('#mix-returning').textContent = returningCount;
      $('#mix-bar-new').style.width = `${newPct}%`;
      $('#mix-bar-returning').style.width = `${retPct}%`;
    }

    (async () => {
      const user = await requireAuth();
      if (!isAdmin()) { location.replace('/day'); return; }

      state.clinicId = getActiveClinicId();
      await loadData();

      const filterEl = $('#dash-filter');
      filterEl.addEventListener('change', () => {
        state.currentRange = getDateRange(filterEl.value);
        render();
      });

      state.currentRange = getDateRange('today');
      render();
    })();
  </script>
</AppLayout>