---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Appointment">
  <div class="min-h-[calc(100vh-52px)] md:py-10 md:px-6 bg-[#fafafb]">
    <div class="w-full max-w-[560px] mx-auto bg-white md:rounded-2xl md:shadow-panel md:border md:border-hairline overflow-hidden">

      <!-- Header -->
      <div class="px-5 pt-5 pb-4 border-b border-hairline">
        <div class="flex items-start justify-between gap-3 mb-2">
          <div class="min-w-0">
            <div id="appt-patient" class="text-[17px] font-semibold truncate">—</div>
            <div id="appt-phone" class="text-[12.5px] text-ink-mute truncate">—</div>
          </div>
          <button id="appt-close" type="button" aria-label="Close"
            class="w-8 h-8 shrink-0 grid place-items-center rounded-lg hover:bg-surface-hover">
            <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
          </button>
        </div>
        <div class="flex items-baseline gap-2 text-[12.5px]">
          <span id="appt-date" class="text-ink-mute">—</span>
          <span class="text-ink-faint">·</span>
          <span id="appt-slot" class="text-ink font-medium tnum">—</span>
        </div>
      </div>

      <!-- Details -->
      <div id="appt-body">
        <div class="px-5 py-4 border-b border-hairline grid grid-cols-3 gap-3 text-[12.5px]">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Type</div>
            <div id="appt-type" class="text-ink">—</div>
          </div>
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Mode</div>
            <div id="appt-mode" class="text-ink">—</div>
          </div>
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Status</div>
            <div id="appt-status" class="text-ink-mute">—</div>
          </div>
        </div>

        <!-- Dynamic action buttons -->
        <div id="appt-actions" class="px-5 py-4 space-y-2 border-b border-hairline"></div>

        <!-- Reason picker (shown on cancel) -->
        <div id="appt-reason" hidden class="px-5 py-4 border-b border-hairline"></div>

        <!-- Follow-up picker (shown on mark seen) -->
        <div id="appt-followup" hidden class="px-5 py-4 border-b border-hairline"></div>
      </div>

    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { startStatusFlow } from '../js/status-flow.js';

    (async () => {
      await requireAuth();
      await startStatusFlow();
    })();
  </script>
</AppLayout>