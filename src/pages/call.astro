---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Call">
  <div class="min-h-[calc(100vh-52px)] md:py-10 md:px-6 bg-[#fafafb]">
    <div class="w-full max-w-[560px] mx-auto bg-white md:rounded-2xl md:shadow-panel md:border md:border-hairline overflow-hidden">

      <div class="px-5 pt-5 pb-4 border-b border-hairline">
        <div class="flex items-start justify-between gap-3 mb-2">
          <div class="min-w-0">
            <div id="call-name" class="text-[17px] font-semibold truncate">—</div>
            <div id="call-phone" class="text-[12.5px] text-ink-mute truncate">—</div>
          </div>
          <button id="call-close" type="button" aria-label="Close"
            class="w-8 h-8 shrink-0 grid place-items-center rounded-lg hover:bg-surface-hover">
            <i class="bi bi-x-lg text-[14px]" aria-hidden="true"></i>
          </button>
        </div>
        <div class="flex items-center gap-2 text-[12.5px]">
          <span id="call-status" class="text-ink-mute">—</span>
          <span class="text-ink-faint">·</span>
          <span id="call-created" class="text-ink-faint tnum">—</span>
        </div>
      </div>

      <div id="call-body">
        <div class="px-5 py-4 border-b border-hairline">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1.5">Reason</div>
          <div id="call-reason" class="text-[14px] text-ink whitespace-pre-wrap">—</div>
        </div>

        <div id="call-actions" class="px-5 py-4 space-y-2 border-b border-hairline"></div>

        <div class="px-5 py-4">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">History</div>
          <div id="call-history"></div>
        </div>
      </div>

    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { startCallView } from '../js/call-view.js';

    (async () => {
      await requireAuth();
      await startCallView();
    })();
  </script>
</AppLayout>