---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Patients">
  <div class="w-full max-w-[1200px] mx-auto px-4 md:px-8 py-6 flex flex-col h-full bg-surface">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-1">Directory</div>
        <div class="text-[24px] font-bold text-ink tracking-tight">Patients</div>
      </div>
      <button id="pt-new" type="button"
        class="h-10 px-5 rounded-xl bg-ink hover:bg-ink/90 text-white text-[13px] font-bold transition-colors shadow-sm flex items-center gap-2">
        <i class="bi bi-person-plus"></i> New Patient
      </button>
    </div>

    <!-- Search Bar -->
    <div class="mb-4">
      <div class="relative">
        <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-ink-faint text-[16px]"></i>
        <input id="pt-search" type="search" autocomplete="off" placeholder="Search by name or phone..."
          class="w-full h-12 pl-12 pr-4 rounded-xl border border-hairline bg-white text-[15px] focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all shadow-sm" />
      </div>
    </div>

    <!-- List Container -->
    <div class="flex-1 overflow-y-auto bg-white rounded-2xl shadow-sm border border-hairline">
      <div id="pt-list" class="divide-y divide-hairline">
        <!-- Filled by JS -->
      </div>
    </div>

  </div>

  <!-- New patient modal -->
  <div id="np-backdrop" hidden class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm transition-opacity"></div>
  
  <div id="np-modal" hidden
    class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-50 w-[min(94vw,460px)]
           bg-white rounded-2xl shadow-xl border border-hairline overflow-hidden">
    
    <div class="px-5 py-4 border-b border-hairline bg-surface-hover/30 flex items-center justify-between">
      <div class="text-[16px] font-bold text-ink">Add New Patient</div>
      <button id="np-close" type="button" aria-label="Close"
        class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover text-ink-mute">
        <i class="bi bi-x-lg text-[16px]"></i>
      </button>
    </div>
    
    <div class="p-5 space-y-4">
      <div>
        <label class="block text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-2">Full Name</label>
        <input id="np-name" type="text" autocomplete="off" placeholder="e.g. Ramamurthy T"
          class="w-full h-11 px-4 rounded-xl border border-hairline bg-surface text-[14px] focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" />
      </div>
      <div>
        <label class="block text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-2">Phone Number</label>
        <input id="np-phone" type="tel" inputmode="tel" autocomplete="off" placeholder="10-digit mobile number"
          class="w-full h-11 px-4 rounded-xl border border-hairline bg-surface text-[14px] focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" />
      </div>
    </div>
    
    <div class="px-5 py-4 border-t border-hairline bg-surface-hover/30 flex gap-3">
      <button id="np-cancel" type="button"
        class="flex-1 h-10 rounded-xl bg-white hover:bg-surface-hover text-ink border border-hairline text-[13px] font-semibold transition-colors">Cancel</button>
      <button id="np-save" type="button" disabled
        class="flex-1 h-10 rounded-xl bg-accent hover:bg-accent-hover text-white text-[13px] font-bold transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Create Patient</button>
    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { searchByName, searchByPhone, create as createPatient, findExact } from '../js/patients.js';
    import { showToast } from '../js/lib/toast.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      results: [],
      saving: false
    };

    function esc(s) {
      return String(s == null ? '' : s)
        .split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;')
        .split('"').join('&quot;').split("'").join('&#39;');
    }

    function render() {
      const root = $('#pt-list');
      if (!root) return;

      const q = $('#pt-search').value.trim();
      
      if (q.length < 2) {
        root.innerHTML = `
          <div class="p-16 flex flex-col items-center justify-center text-center">
            <div class="w-16 h-16 bg-surface-hover rounded-full flex items-center justify-center mb-4">
               <i class="bi bi-search text-[24px] text-ink-faint"></i>
            </div>
            <div class="text-[15px] font-bold text-ink mb-1">Search the directory</div>
            <div class="text-[13px] text-ink-mute max-w-[250px]">Type at least 2 characters to search by patient name or phone number.</div>
          </div>`;
        return;
      }

      if (state.results.length === 0) {
        root.innerHTML = `
          <div class="p-16 flex flex-col items-center justify-center text-center">
            <div class="w-16 h-16 bg-orange-50 rounded-full flex items-center justify-center mb-4">
               <i class="bi bi-person-x text-[24px] text-orange-500"></i>
            </div>
            <div class="text-[15px] font-bold text-ink mb-1">No matches found</div>
            <div class="text-[13px] text-ink-mute max-w-[250px] mb-4">We couldn't find anyone matching "${esc(q)}".</div>
            <button onclick="document.getElementById('pt-new').click()" class="h-9 px-4 rounded-lg bg-accent text-white text-[13px] font-bold shadow-sm hover:bg-accent-hover transition-colors">Create New Patient</button>
          </div>`;
        return;
      }

      root.innerHTML = state.results.map((p) => `
        <div data-pid="${esc(p.id)}"
          class="flex items-center gap-4 px-4 md:px-6 py-4 hover:bg-surface-hover cursor-pointer transition-colors border-b border-hairline last:border-b-0">
          
          <div class="w-10 h-10 rounded-full bg-accent-soft text-accent flex items-center justify-center shrink-0 font-bold text-[14px]">
            ${esc((p.name || '?').charAt(0).toUpperCase())}
          </div>

          <div class="flex-1 min-w-0">
            <div class="text-[15px] font-bold text-ink truncate">${esc(p.name)}</div>
            <div class="text-[13px] text-ink-mute truncate mt-0.5">${esc(p.phone || 'No phone')}</div>
          </div>
          
          <div class="shrink-0 text-ink-faint">
            <i class="bi bi-chevron-right text-[16px]"></i>
          </div>
        </div>`).join('');

      root.querySelectorAll('[data-pid]').forEach((el) => {
        el.addEventListener('click', () => {
          location.href = `/patient?id=${encodeURIComponent(el.getAttribute('data-pid'))}`;
        });
      });
    }

    async function runSearch(q) {
      try {
        const byName = await searchByName(state.clinicId, q, 20);
        const byPhone = /^[0-9+ -]{4,}$/.test(q) ? await searchByPhone(state.clinicId, q) : [];
        const merged = [];
        const seen = new Set();
        for (const p of [...byName, ...byPhone]) {
          if (seen.has(p.id)) continue;
          seen.add(p.id);
          merged.push(p);
        }
        merged.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        state.results = merged;
      } catch (err) {
        state.results = [];
      }
      render();
    }

    function wireSearch() {
      let timer = null;
      $('#pt-search').addEventListener('input', (e) => {
        clearTimeout(timer);
        const q = e.target.value.trim();
        if (q.length < 2) { state.results = []; render(); return; }
        timer = setTimeout(() => runSearch(q), 250);
      });
    }

    function openModal() {
      $('#np-backdrop').hidden = false;
      $('#np-modal').hidden = false;
      $('#np-name').value = '';
      $('#np-phone').value = '';
      $('#np-save').disabled = true;
      setTimeout(() => $('#np-name').focus(), 50);
    }

    function closeModal() {
      $('#np-backdrop').hidden = true;
      $('#np-modal').hidden = true;
    }

    function updateSaveState() {
      const name = $('#np-name').value.trim();
      $('#np-save').disabled = !name || state.saving;
    }

    async function saveNew() {
      if (state.saving) return;
      const name = $('#np-name').value.trim();
      const phone = $('#np-phone').value.trim();

      try {
        const existing = await findExact(state.clinicId, name.toLowerCase());
        if (existing) {
          const proceed = confirm(
            'A patient named "' + existing.name + '" already exists' +
            (existing.phone ? ' (' + existing.phone + ')' : '') +
            '.\n\nCreate a new patient with the same name anyway?\n\n' +
            'Click Cancel to use the existing patient instead.'
          );
          if (!proceed) {
            location.href = `/patient?id=${encodeURIComponent(existing.id)}`;
            return;
          }
        }
      } catch (err) {}

      state.saving = true;
      $('#np-save').textContent = 'Creating...';
      updateSaveState();
      
      try {
        const id = await createPatient({ clinicId: state.clinicId, name, phone });
        showToast('Patient added');
        setTimeout(() => { location.href = `/patient?id=${encodeURIComponent(id)}`; }, 400);
      } catch (err) {
        showToast('Could not add patient', 'error');
        state.saving = false;
        $('#np-save').textContent = 'Create Patient';
        updateSaveState();
      }
    }

    function wireModal() {
      $('#pt-new').addEventListener('click', openModal);
      $('#np-close').addEventListener('click', closeModal);
      $('#np-cancel').addEventListener('click', closeModal);
      $('#np-backdrop').addEventListener('click', closeModal);
      $('#np-name').addEventListener('input', updateSaveState);
      $('#np-save').addEventListener('click', saveNew);
    }

    (async () => {
      await requireAuth();
      state.clinicId = getActiveClinicId();
      wireSearch();
      wireModal();
      render();
    })();
  </script>
</AppLayout>