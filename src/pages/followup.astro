---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Follow-up">
  <div class="h-[calc(100vh-52px)] flex flex-col bg-surface overflow-hidden">

    <!-- Header -->
    <div class="px-4 md:px-8 py-4 md:py-6 bg-white border-b border-hairline shrink-0">
      <div class="max-w-[1100px] mx-auto flex items-start justify-between gap-4">
        
        <div class="flex items-center gap-4">
          <button id="fu-close" type="button" aria-label="Close"
            class="w-10 h-10 shrink-0 grid place-items-center rounded-full bg-white border border-hairline hover:bg-surface-hover text-ink-mute transition-all shadow-sm">
            <i class="bi bi-arrow-left text-[18px]"></i>
          </button>
          
          <div>
            <div id="fu-name" class="text-[20px] md:text-[24px] font-bold text-ink tracking-tight">—</div>
            <div id="fu-phone" class="text-[13px] text-ink-mute mt-0.5">—</div>
          </div>
        </div>

        <div class="flex flex-col items-end gap-1">
          <div id="fu-status" class="text-[12px] font-bold uppercase tracking-widest text-ink-mute bg-surface-hover px-3 py-1 rounded-full">—</div>
          <div class="flex items-center gap-2 text-[13px]">
            <span class="text-ink-faint">Due</span>
            <span id="fu-due" class="font-bold text-ink tnum">—</span>
            <span id="fu-due-rel" class="text-[12px] font-semibold text-accent"></span>
          </div>
        </div>

      </div>
    </div>

    <!-- Main Content -->
    <div id="fu-body" class="flex-1 overflow-y-auto">
      <div class="max-w-[1100px] mx-auto px-4 md:px-8 py-6 md:py-8 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Info & Actions -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          
          <!-- Info Card -->
          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-5">
            <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-4">Follow-up Details</div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <div class="text-[11px] text-ink-mute mb-0.5">Seen on</div>
                <div id="fu-seen" class="text-[14px] font-semibold text-ink tnum">—</div>
              </div>
              <div>
                <div class="text-[11px] text-ink-mute mb-0.5">Interval</div>
                <div id="fu-interval" class="text-[14px] font-semibold text-ink">—</div>
              </div>
              <div class="col-span-2 pt-3 border-t border-hairline">
                <div class="text-[11px] text-ink-mute mb-0.5">Status</div>
                <div id="fu-status-inline" class="text-[14px] font-semibold text-ink capitalize">—</div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div id="fu-actions" class="bg-white rounded-2xl shadow-sm border border-hairline p-5 space-y-3"></div>

        </div>

        <!-- Right: History -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl shadow-sm border border-hairline p-5 h-full">
            <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-4">Activity History</div>
            <div id="fu-history" class="space-y-1"></div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { startFollowupView } from '../js/followup-view.js';

    (async () => {
      await requireAuth();
      await startFollowupView();
    })();
  </script>
</AppLayout>