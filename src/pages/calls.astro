---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Calls">
  <div class="w-full max-w-[1200px] mx-auto px-3 md:px-8 py-4 md:py-6 flex flex-col h-[calc(100vh-52px)] overflow-hidden bg-surface">

    <!-- Header -->
    <div class="flex items-center justify-between gap-3 mb-4 md:mb-6 shrink-0">
      <div class="min-w-0">
        <div class="text-[10px] md:text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-0.5 md:mb-1">Phone</div>
        <div class="flex items-center gap-2 md:gap-3 flex-wrap">
          <div class="text-[18px] md:text-[22px] font-bold text-ink tracking-tight truncate">Pending Tasks</div>
          <div id="calls-sub" class="text-[11px] md:text-[12px] font-semibold text-accent bg-accent-soft px-2 py-0.5 rounded-full">—</div>
        </div>
      </div>
      <button id="calls-new" type="button"
        class="h-9 md:h-10 px-3 md:px-5 rounded-xl bg-ink hover:bg-ink/90 text-white text-[12px] md:text-[13px] font-bold transition-colors shadow-sm flex items-center gap-1.5 md:gap-2 shrink-0">
        <i class="bi bi-plus-lg"></i>
        <span class="hidden sm:inline">Add Call</span>
      </button>
    </div>

    <!-- List Container -->
    <div class="flex-1 bg-white rounded-2xl shadow-sm border border-hairline overflow-y-auto">
      <div id="calls-list">
        <!-- Filled by JS -->
      </div>
    </div>

  </div>

  <!-- ========================================== -->
  <!-- New Call Modal — bottom sheet mobile / card desktop -->
  <!-- ========================================== -->
  <div id="newcall-backdrop" class="hidden fixed inset-0 z-40 bg-black/40 backdrop-blur-sm"></div>

  <div id="newcall-modal" class="hidden fixed z-50 bg-white shadow-xl border border-hairline overflow-hidden flex-col
           bottom-0 left-0 right-0 rounded-t-3xl w-full max-h-[90vh]
           md:bottom-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2
           md:w-[440px] md:rounded-2xl md:max-h-[85vh] md:overflow-y-auto">

    <div class="px-5 py-4 border-b border-hairline bg-surface-hover/30 shrink-0 flex items-center justify-between">
      <div class="text-[16px] font-bold text-ink">Add Call</div>
      <button id="newcall-close" type="button" aria-label="Close"
        class="w-8 h-8 grid place-items-center rounded-lg hover:bg-surface-hover text-ink-mute shrink-0">
        <i class="bi bi-x-lg text-[16px]"></i>
      </button>
    </div>

    <div class="p-5 space-y-4 overflow-y-auto">

      <!-- Patient search -->
      <div class="relative">
        <label class="block text-[12px] font-medium text-ink-mute mb-1">Patient</label>
        <input id="nc-search" type="text" autocomplete="off" placeholder="Search by name or phone..."
          class="w-full h-11 px-3 rounded-xl border border-hairline bg-surface text-[14px] focus:outline-none focus:border-accent" />
        <div id="nc-results" class="mt-1 rounded-xl border border-hairline bg-white overflow-hidden max-h-[180px] overflow-y-auto shadow-md empty:hidden"></div>
        <div id="nc-chosen" hidden class="mt-2 px-3 py-2 rounded-xl bg-accent-soft text-accent font-medium text-[12px] border border-accent/20 flex items-center gap-1.5">
          <i class="bi bi-check-circle-fill"></i>
          <span id="nc-chosen-name"></span>
        </div>
      </div>

      <!-- Phone (only shown when no existing patient is selected) -->
      <div id="nc-phone-wrap">
        <label class="block text-[12px] font-medium text-ink-mute mb-1">Phone Number</label>
        <input id="nc-phone" type="tel" autocomplete="off" placeholder="Phone number (optional)"
          class="w-full h-11 px-3 rounded-xl border border-hairline bg-surface text-[14px] focus:outline-none focus:border-accent" />
        <div class="text-[11px] text-ink-faint mt-1">Leave blank if patient already exists in the system.</div>
      </div>

      <!-- Reason -->
      <div>
        <label class="block text-[12px] font-medium text-ink-mute mb-1">Reason</label>
        <textarea id="nc-reason" rows="3" placeholder="What did they call about?"
          class="w-full px-3 py-2.5 rounded-xl border border-hairline bg-surface text-[14px] resize-none focus:outline-none focus:border-accent"></textarea>
      </div>

    </div>

    <div class="px-5 py-4 border-t border-hairline bg-surface-hover/30 flex gap-3 shrink-0">
      <button id="newcall-cancel" type="button"
        class="flex-1 h-10 rounded-xl bg-white hover:bg-surface-hover text-ink border border-hairline text-[13px] font-semibold transition-colors">Cancel</button>
      <button id="newcall-save" type="button" disabled
        class="flex-1 h-10 rounded-xl bg-accent hover:bg-accent-hover text-white text-[13px] font-bold transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Add Call</button>
    </div>

  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { subscribeMergedPending, create as createCall } from '../js/calls.js';
    import { searchByName, searchByPhone } from '../js/patients.js';
    import { showToast } from '../js/lib/toast.js';
    import { esc } from '../js/lib/format.js';
    import { fmtDate, fmtSlot } from '../js/date-utils.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      pending: { problem: [], scheduled: [] },
      unsubscribe: null,
      newCallPatient: null,   // { id, name, phone } when picked from search
      saving: false
    };

    // ============================================================
    // LIST RENDER — two sections
    // ============================================================
    function render() {
      const root = $('#calls-list');
      const sub = $('#calls-sub');
      if (!root) return;

      const problem = state.pending.problem || [];
      const scheduled = state.pending.scheduled || [];
      const total = problem.length + scheduled.length;

      if (sub) {
        sub.textContent = total === 0 ? 'None' : `${total} pending`;
      }

      if (total === 0) {
        root.innerHTML = `
          <div class="p-12 text-center flex flex-col items-center justify-center">
            <div class="w-16 h-16 bg-surface-hover rounded-full flex items-center justify-center mb-4">
               <i class="bi bi-telephone text-[24px] text-ink-faint"></i>
            </div>
            <div class="text-[15px] font-bold text-ink mb-1">No pending tasks</div>
            <div class="text-[13px] text-ink-mute mb-4">When a patient calls in or has a scheduled call, it will appear here.</div>
            <button id="empty-new-btn" class="h-9 px-4 rounded-lg bg-accent text-white text-[13px] font-bold shadow-sm hover:bg-accent-hover transition-colors">Add Call</button>
          </div>`;
        const emptyBtn = $('#empty-new-btn');
        if (emptyBtn) emptyBtn.addEventListener('click', openModal);
        return;
      }

      const html = [];

      if (scheduled.length > 0) {
        html.push(`
          <div class="px-4 md:px-6 py-2 bg-blue-50 border-y border-blue-100 sticky top-0 z-10">
            <div class="text-[10px] font-bold tracking-widest uppercase text-blue-700 flex items-center gap-1.5">
              <i class="bi bi-telephone-fill"></i> Scheduled Calls · ${scheduled.length}
            </div>
          </div>
        `);
        scheduled.forEach(c => html.push(renderRow(c, 'scheduled')));
      }

      if (problem.length > 0) {
        html.push(`
          <div class="px-4 md:px-6 py-2 bg-pink-50 border-y border-pink-100 sticky top-0 z-10">
            <div class="text-[10px] font-bold tracking-widest uppercase text-pink-700 flex items-center gap-1.5">
              <i class="bi bi-exclamation-triangle-fill"></i> Problem Calls · ${problem.length}
            </div>
          </div>
        `);
        problem.forEach(c => html.push(renderRow(c, 'problem')));
      }

      root.innerHTML = html.join('');

      root.querySelectorAll('[data-call-id]').forEach((el) => {
        el.addEventListener('click', () => {
          const type = el.getAttribute('data-type');
          const id = el.getAttribute('data-call-id');
          if (type === 'problem') {
            location.href = `/call?id=${encodeURIComponent(id)}`;
          } else {
            location.href = `/appointment?id=${encodeURIComponent(id)}`;
          }
        });
      });
    }

    function renderRow(c, type) {
      const isProblem = type === 'problem';
      const leftBorder = isProblem ? 'border-l-[3px] border-l-pink-400' : 'border-l-[3px] border-l-blue-400';
      const iconBg = isProblem ? 'bg-pink-50 text-pink-500' : 'bg-blue-50 text-blue-500';
      const icon = isProblem ? 'bi-telephone-fill' : 'bi-calendar-check-fill';
      const badgeCls = isProblem ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700';
      const badgeLabel = isProblem ? 'Problem' : 'Scheduled';

      const subtitle = isProblem
        ? (c.reason || 'No reason')
        : `Scheduled for ${fmtDate(c.date)} at ${fmtSlot(c.slot)}`;

      return `
        <div data-call-id="${esc(c.id)}" data-type="${esc(type)}"
          class="flex items-center gap-3 md:gap-4 px-4 md:px-6 py-3 md:py-4 ${leftBorder} hover:bg-surface-hover cursor-pointer transition-colors border-b border-hairline last:border-b-0">

          <div class="w-9 h-9 md:w-10 md:h-10 rounded-full flex items-center justify-center shrink-0 ${iconBg}">
            <i class="bi ${icon} text-[14px] md:text-[15px]"></i>
          </div>

          <div class="flex-1 min-w-0">
            <div class="text-[14px] md:text-[15px] font-bold text-ink truncate">${esc(c.patientName || 'Patient')}</div>
            <div class="text-[12px] md:text-[13px] text-ink-mute truncate mt-0.5">${esc(subtitle)}</div>
          </div>

          <div class="shrink-0 hidden sm:block">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${badgeCls}">${badgeLabel}</span>
          </div>

          <div class="shrink-0 text-ink-faint">
            <i class="bi bi-chevron-right text-[14px] md:text-[16px]"></i>
          </div>
        </div>`;
    }

    // ============================================================
    // DATA — realtime subscription
    // ============================================================
    function startSubscription() {
      if (state.unsubscribe) {
        try { state.unsubscribe(); } catch {}
        state.unsubscribe = null;
      }
      state.pending = { problem: [], scheduled: [] };
      render();

      state.unsubscribe = subscribeMergedPending(
        state.clinicId,
        (merged) => {
          state.pending = merged;
          render();
        },
        (err) => {
          console.error('[calls-page] subscription failed', err);
        }
      );
    }

    // ============================================================
    // NEW CALL MODAL
    // ============================================================
    function openModal() {
      const backdrop = $('#newcall-backdrop');
      const modal = $('#newcall-modal');
      if (!backdrop || !modal) return;

      backdrop.classList.remove('hidden');
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      state.newCallPatient = null;
      $('#nc-search').value = '';
      $('#nc-phone').value = '';
      $('#nc-reason').value = '';
      $('#nc-results').innerHTML = '';
      $('#nc-chosen').hidden = true;
      $('#nc-phone-wrap').classList.remove('hidden');
      $('#newcall-save').disabled = true;

      setTimeout(() => $('#nc-search').focus(), 150);
    }

    function closeModal() {
      const backdrop = $('#newcall-backdrop');
      const modal = $('#newcall-modal');
      if (!backdrop || !modal) return;

      backdrop.classList.add('hidden');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function updateSaveState() {
      const nameTyped = $('#nc-search').value.trim().length > 0;
      const reasonTyped = $('#nc-reason').value.trim().length > 0;
      const ok = nameTyped && reasonTyped && !state.saving;
      $('#newcall-save').disabled = !ok;
    }

    function wireModal() {
      $('#calls-new')?.addEventListener('click', openModal);
      $('#newcall-close')?.addEventListener('click', closeModal);
      $('#newcall-cancel')?.addEventListener('click', closeModal);
      $('#newcall-backdrop')?.addEventListener('click', closeModal);

      let timer = null;
      $('#nc-search')?.addEventListener('input', (e) => {
        // Typing invalidates any previously picked patient
        state.newCallPatient = null;
        $('#nc-chosen').hidden = true;
        $('#nc-phone-wrap').classList.remove('hidden');
        updateSaveState();

        clearTimeout(timer);
        const q = e.target.value.trim();
        if (q.length < 2) { $('#nc-results').innerHTML = ''; return; }
        timer = setTimeout(() => runSearch(q), 250);
      });

      $('#nc-results')?.addEventListener('click', (e) => {
        const row = e.target.closest('[data-pid]');
        if (!row) return;
        state.newCallPatient = {
          id: row.getAttribute('data-pid'),
          name: row.getAttribute('data-pname'),
          phone: row.getAttribute('data-pphone')
        };
        $('#nc-search').value = state.newCallPatient.name;
        $('#nc-phone').value = state.newCallPatient.phone || '';
        $('#nc-results').innerHTML = '';
        $('#nc-chosen-name').textContent = state.newCallPatient.name;
        $('#nc-chosen').hidden = false;
        // Hide the phone field — patient already has a phone on file
        $('#nc-phone-wrap').classList.add('hidden');
        updateSaveState();
      });

      $('#nc-phone')?.addEventListener('input', updateSaveState);
      $('#nc-reason')?.addEventListener('input', updateSaveState);
      $('#newcall-save')?.addEventListener('click', saveCall);
    }

    async function runSearch(q) {
      try {
        const byName = await searchByName(state.clinicId, q, 8);
        const byPhone = /^[0-9+ -]{4,}$/.test(q) ? await searchByPhone(state.clinicId, q) : [];
        const merged = [];
        const seen = new Set();
        for (const p of [...byName, ...byPhone]) {
          if (seen.has(p.id)) continue;
          seen.add(p.id);
          merged.push(p);
        }
        const root = $('#nc-results');
        if (merged.length === 0) {
          root.innerHTML = `<div class="px-3 py-3 text-[13px] text-ink-faint">No matches. You can add this call as a new patient below.</div>`;
          return;
        }
        root.innerHTML = merged.map((p) => `
          <div data-pid="${esc(p.id)}" data-pname="${esc(p.name)}" data-pphone="${esc(p.phone || '')}"
            class="px-4 py-3 hover:bg-surface-hover cursor-pointer border-b border-hairline last:border-b-0 transition-colors">
            <div class="text-[14px] font-bold text-ink">${esc(p.name)}</div>
            ${p.phone ? `<div class="text-[12px] text-ink-mute mt-0.5">${esc(p.phone)}</div>` : ''}
          </div>`).join('');
      } catch (err) {
        console.error('[calls-page] search failed:', err);
      }
    }

    async function saveCall() {
      if (state.saving) return;

      const typedName = $('#nc-search').value.trim();
      const typedPhone = $('#nc-phone').value.trim();
      const reason = $('#nc-reason').value.trim();

      if (!typedName || !reason) {
        showToast('Name and reason are required', 'error');
        return;
      }

      state.saving = true;
      const saveBtn = $('#newcall-save');
      saveBtn.textContent = 'Saving...';
      saveBtn.disabled = true;

      try {
        const payload = {
          clinicId: state.clinicId,
          patientId: state.newCallPatient ? state.newCallPatient.id : null,
          patientName: state.newCallPatient ? state.newCallPatient.name : typedName,
          patientPhone: state.newCallPatient ? (state.newCallPatient.phone || '') : typedPhone,
          reason
        };
        await createCall(payload);
        showToast('Call added', 'success');
        closeModal();
        // Realtime subscription will refresh the list automatically.
      } catch (err) {
        console.error('[calls-page] save failed:', err);
        showToast('Could not add call', 'error');
      } finally {
        state.saving = false;
        saveBtn.textContent = 'Add Call';
        updateSaveState();
      }
    }

    // ============================================================
    // START
    // ============================================================
    (async () => {
      await requireAuth();
      state.clinicId = getActiveClinicId();
      wireModal();
      startSubscription();

      window.addEventListener('beforeunload', () => {
        if (state.unsubscribe) {
          try { state.unsubscribe(); } catch {}
        }
      });
    })();
  </script>
</AppLayout>