---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Settings">
  <div class="p-6 md:p-8 max-w-[720px]">
    <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-2">
      Admin
    </div>
    <div class="text-[22px] font-semibold mb-8">Clinic Schedule</div>

    <form id="settings-form" class="space-y-6 bg-white rounded-xl border border-hairline p-6">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[13px] font-medium text-ink mb-1">Opening Time</label>
          <input type="time" id="set-open" required class="w-full h-10 px-3 rounded-lg border border-hairline text-[14px]">
        </div>
        <div>
          <label class="block text-[13px] font-medium text-ink mb-1">Closing Time</label>
          <input type="time" id="set-close" required class="w-full h-10 px-3 rounded-lg border border-hairline text-[14px]">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[13px] font-medium text-ink mb-1">Slot Duration (mins)</label>
          <input type="number" id="set-slot" required min="5" step="5" class="w-full h-10 px-3 rounded-lg border border-hairline text-[14px]">
        </div>
        <div>
          <label class="block text-[13px] font-medium text-ink mb-1">Slots for New Patients</label>
          <input type="number" id="set-new-slots" required min="1" step="1" class="w-full h-10 px-3 rounded-lg border border-hairline text-[14px]">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[13px] font-medium text-ink mb-1">Break Start (optional)</label>
          <input type="time" id="set-break-start" class="w-full h-10 px-3 rounded-lg border border-hairline text-[14px]">
        </div>
        <div>
          <label class="block text-[13px] font-medium text-ink mb-1">Break End (optional)</label>
          <input type="time" id="set-break-end" class="w-full h-10 px-3 rounded-lg border border-hairline text-[14px]">
        </div>
      </div>

      <div>
        <label class="block text-[13px] font-medium text-ink mb-2">Days Open</label>
        <div class="flex gap-3 flex-wrap">
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="0" class="rounded border-hairline"> Sun</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="1" class="rounded border-hairline"> Mon</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="2" class="rounded border-hairline"> Tue</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="3" class="rounded border-hairline"> Wed</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="4" class="rounded border-hairline"> Thu</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="5" class="rounded border-hairline"> Fri</label>
          <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="days" value="6" class="rounded border-hairline"> Sat</label>
        </div>
      </div>

      <div class="pt-2 flex justify-end">
        <button type="submit" id="settings-save"
          class="h-10 px-6 rounded-lg bg-accent hover:bg-accent-hover text-white text-[13px] font-medium transition-colors">
          Save changes
        </button>
      </div>
    </form>
  </div>

  <script>
    import { requireAuth, isAdmin } from '../js/lib/auth-guards.js';
    import { startSettingsView } from '../js/settings-view.js';

    (async () => {
      await requireAuth();
      if (!isAdmin()) { location.replace('/day'); return; }
      await startSettingsView();
    })();
  </script>
</AppLayout>