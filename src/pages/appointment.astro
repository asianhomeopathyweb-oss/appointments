---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Appointment">
  <div class="w-full max-w-[1100px] mx-auto px-4 md:px-8 py-6 flex flex-col h-full bg-surface">

    <!-- Header -->
    <div class="flex items-center gap-4 mb-6">
      <button id="appt-close" type="button" aria-label="Close"
        class="w-10 h-10 shrink-0 grid place-items-center rounded-full bg-white border border-hairline shadow-sm hover:border-accent text-ink-mute transition-all">
        <i class="bi bi-arrow-left text-[18px]"></i>
      </button>
      <div>
        <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-0.5">Appointment</div>
        <div id="appt-patient" class="text-[22px] font-bold text-ink tracking-tight">—</div>
        <div id="appt-phone" class="text-[13px] text-ink-mute mt-0.5">—</div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1">
      
      <!-- LEFT: Details -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- When -->
        <div class="bg-white rounded-2xl shadow-sm border border-hairline p-6">
          <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-4">When</div>
          <div id="appt-date" class="text-[20px] font-bold text-ink tracking-tight mb-1">—</div>
          <div id="appt-slot" class="text-[15px] font-semibold text-accent tnum">—</div>
        </div>

        <!-- Type, Mode, Status -->
        <div class="bg-white rounded-2xl shadow-sm border border-hairline p-6">
          <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-4">Details</div>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-ink-mute">Type</div>
              <div id="appt-type" class="text-[14px] font-bold text-ink">—</div>
            </div>
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-ink-mute">Mode</div>
              <div id="appt-mode" class="text-[14px] font-bold text-ink">—</div>
            </div>
            <div class="flex items-center justify-between">
              <div class="text-[13px] text-ink-mute">Status</div>
              <div id="appt-status" class="text-[13px] font-bold uppercase tracking-wider text-ink-mute">—</div>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT: Actions -->
      <div class="lg:col-span-7 flex flex-col">
        <div id="appt-body" class="bg-white rounded-2xl shadow-sm border border-hairline flex flex-col h-full overflow-hidden">
          
          <div class="px-6 py-4 border-b border-hairline bg-surface-hover/30">
            <div class="text-[11px] font-bold tracking-widest text-ink-mute uppercase">Actions</div>
          </div>

          <!-- Dynamic actions -->
          <div id="appt-actions" class="p-6 space-y-3 flex-1"></div>

          <!-- Reason picker -->
          <div id="appt-reason" hidden class="p-6 border-t border-hairline bg-surface-hover/10"></div>

          <!-- Follow-up picker -->
          <div id="appt-followup" hidden class="p-6 border-t border-hairline bg-surface-hover/10"></div>

        </div>
      </div>

    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { startStatusFlow } from '../js/status-flow.js';

    (async () => {
      await requireAuth();
      await startStatusFlow();
    })();
  </script>
</AppLayout>