---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Call">
  <div class="w-full max-w-[1100px] mx-auto px-4 md:px-8 py-6 flex flex-col h-full bg-surface">

    <!-- Header -->
    <div class="flex items-start gap-3 md:gap-4 mb-5 md:mb-6 flex-wrap">
      <button id="call-close" type="button" aria-label="Close"
        class="w-10 h-10 shrink-0 grid place-items-center rounded-full bg-white border border-hairline shadow-sm hover:border-accent text-ink-mute transition-all">
        <i class="bi bi-arrow-left text-[18px]"></i>
      </button>
      <div class="flex-1 min-w-0">
        <div class="text-[10px] md:text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-0.5">Call Log</div>
        <div id="call-name" class="text-[18px] md:text-[22px] font-bold text-ink tracking-tight truncate">—</div>
        <div id="call-phone" class="text-[12px] md:text-[13px] text-ink-mute mt-0.5">—</div>
      </div>
      <div class="shrink-0 ml-auto">
        <span id="call-status" class="text-[11px] md:text-[12px] font-bold uppercase tracking-widest text-ink-mute bg-surface-hover px-2 md:px-3 py-1 rounded-full">—</span>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1">
      
      <!-- LEFT: Reason & Meta -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <div class="bg-white rounded-2xl shadow-sm border border-hairline p-6">
          <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase mb-3">Reason</div>
          <div id="call-reason" class="text-[15px] font-medium text-ink whitespace-pre-wrap leading-relaxed">—</div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-hairline p-6">
          <div class="flex items-center justify-between">
            <div class="text-[11px] font-bold tracking-widest text-ink-faint uppercase">Logged</div>
            <div id="call-created" class="text-[13px] font-semibold text-ink-mute tnum">—</div>
          </div>
        </div>

      </div>

      <!-- RIGHT: Actions & History -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        <div id="call-body" class="flex flex-col gap-6 flex-1">
          
          <!-- Actions -->
          <div class="bg-white rounded-2xl shadow-sm border border-hairline flex flex-col">
            <div class="px-6 py-4 border-b border-hairline bg-surface-hover/30 rounded-t-2xl">
              <div class="text-[11px] font-bold tracking-widest text-ink-mute uppercase">Actions</div>
            </div>
            <div id="call-actions" class="p-6 space-y-3"></div>
          </div>

          <!-- History -->
          <div class="bg-white rounded-2xl shadow-sm border border-hairline flex flex-col flex-1">
            <div class="px-6 py-4 border-b border-hairline bg-surface-hover/30 rounded-t-2xl">
              <div class="text-[11px] font-bold tracking-widest text-ink-mute uppercase">History</div>
            </div>
            <div id="call-history" class="p-6 space-y-1"></div>
          </div>

        </div>

      </div>
    </div>
  </div>

  <script>
    import { requireAuth } from '../js/lib/auth-guards.js';
    import { startCallView } from '../js/call-view.js';

    (async () => {
      await requireAuth();
      await startCallView();
    })();
  </script>
</AppLayout>