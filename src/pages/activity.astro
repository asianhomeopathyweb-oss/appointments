---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Activity">
  <div class="max-w-[860px]">

    <div class="px-4 md:px-6 py-4 border-b border-hairline bg-white/80 backdrop-blur sticky top-0 z-10">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint mb-1">Audit trail</div>
          <div class="text-[17px] font-semibold">Activity</div>
        </div>
        <button id="act-refresh" type="button"
          class="h-9 px-3 rounded-lg bg-white hover:bg-surface-hover text-ink border border-hairline text-[12.5px] font-medium inline-flex items-center gap-1.5">
          <i class="bi bi-arrow-clockwise text-[12px]" aria-hidden="true"></i>
          Refresh
        </button>
      </div>

      <div id="act-filters" class="flex gap-1.5 overflow-x-auto -mx-4 md:-mx-6 px-4 md:px-6 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <button type="button" data-cat="all"          class="shrink-0 h-8 px-3 rounded-full text-[12.5px] border border-hairline bg-accent-soft text-accent font-medium">All</button>
        <button type="button" data-cat="appointments" class="shrink-0 h-8 px-3 rounded-full text-[12.5px] border border-hairline bg-white text-ink-mute hover:border-accent">Appointments</button>
        <button type="button" data-cat="followups"    class="shrink-0 h-8 px-3 rounded-full text-[12.5px] border border-hairline bg-white text-ink-mute hover:border-accent">Follow-ups</button>
        <button type="button" data-cat="calls"        class="shrink-0 h-8 px-3 rounded-full text-[12.5px] border border-hairline bg-white text-ink-mute hover:border-accent">Calls</button>
        <button type="button" data-cat="patients"     class="shrink-0 h-8 px-3 rounded-full text-[12.5px] border border-hairline bg-white text-ink-mute hover:border-accent">Patients</button>
      </div>

      <div id="act-sub" class="text-[12.5px] text-ink-mute mt-2">—</div>
    </div>

    <div id="act-list"></div>

  </div>

  <script>
    import { requireAuth, isAdmin } from '../js/lib/auth-guards.js';
    import { getActiveClinicId } from '../js/lib/clinic-context.js';
    import { listRecent, categoryOf } from '../js/activity.js';
    import { fmtDate, todayISO, addDays } from '../js/date-utils.js';

    const $ = (sel) => document.querySelector(sel);

    const state = {
      clinicId: null,
      rows: [],
      filter: 'all',
      loading: false
    };

    function esc(s) {
      return String(s == null ? '' : s)
        .split('&').join('&amp;')
        .split('<').join('&lt;')
        .split('>').join('&gt;')
        .split('"').join('&quot;')
        .split("'").join('&#39;');
    }

    function fmtTime(ms) {
      if (!ms) return '—';
      const d = new Date(ms);
      const h = String(d.getHours()).padStart(2, '0');
      const m = String(d.getMinutes()).padStart(2, '0');
      return `${h}:${m}`;
    }

    function dateKey(ms) {
      const d = new Date(ms);
      const y = d.getFullYear();
      const mo = String(d.getMonth() + 1).padStart(2, '0');
      const da = String(d.getDate()).padStart(2, '0');
      return `${y}-${mo}-${da}`;
    }

    function groupLabel(iso) {
      const t = todayISO();
      if (iso === t) return 'Today';
      if (iso === addDays(t, -1)) return 'Yesterday';
      return fmtDate(iso);
    }

    function pillClass(cat) {
      return {
        appointments: 'bg-accent-soft text-accent',
        followups:    'bg-[#eef2ff] text-[#4f46e5]',
        calls:        'bg-[#fef3c7] text-[#b45309]',
        patients:     'bg-[#f0fdf4] text-[#15803d]',
        other:        'bg-surface-press text-ink-mute'
      }[cat] || 'bg-surface-press text-ink-mute';
    }

    function filtered() {
      if (state.filter === 'all') return state.rows;
      return state.rows.filter((r) => r.category === state.filter);
    }

    function render() {
      const root = $('#act-list');
      const sub = $('#act-sub');
      const list = filtered();

      if (sub) {
        sub.textContent = state.loading
          ? 'Loading…'
          : list.length === 0 ? 'No activity yet' : `${list.length} entr${list.length === 1 ? 'y' : 'ies'}`;
      }

      if (list.length === 0) {
        root.innerHTML = `
          <div class="p-10 text-center">
            <div class="text-[14px] text-ink-mute mb-1">No activity recorded yet.</div>
            <div class="text-[12.5px] text-ink-faint">Actions you take in Appointments appear here.</div>
          </div>`;
        return;
      }

      // Group by date.
      const groups = [];
      let currentKey = null;
      for (const r of list) {
        const k = dateKey(r.ms);
        if (k !== currentKey) {
          groups.push({ key: k, label: groupLabel(k), items: [] });
          currentKey = k;
        }
        groups[groups.length - 1].items.push(r);
      }

      root.innerHTML = groups.map((g) => `
        <div class="px-4 md:px-6 pt-5 pb-2">
          <div class="text-[11px] font-semibold uppercase tracking-wide text-ink-faint">${esc(g.label)}</div>
        </div>
        ${g.items.map((r) => `
          <div class="flex items-center gap-3 px-4 md:px-6 py-3 border-b border-hairline">
            <div class="w-[48px] shrink-0 text-[12.5px] text-ink-mute tnum">${esc(fmtTime(r.ms))}</div>
            <div class="flex-1 min-w-0">
              <div class="text-[14px] font-medium truncate">${esc(r.label)}</div>
              <div class="text-[12.5px] text-ink-mute truncate">
                ${esc(r.name || '—')}
                ${r.role ? `<span class="mx-1 text-ink-faint">·</span>${esc(r.role)}` : ''}
                ${r.targetId ? `<span class="mx-1 text-ink-faint">·</span><span class="text-ink-faint">${esc(r.targetId.slice(0, 8))}…</span>` : ''}
              </div>
            </div>
            <div class="shrink-0">
              <span class="inline-block px-2.5 py-1 rounded-full text-[10.5px] font-semibold uppercase tracking-wide ${pillClass(r.category)}">
                ${esc(r.category)}
              </span>
            </div>
          </div>`).join('')}
      `).join('');
    }

    function wireFilters() {
      document.querySelectorAll('[data-cat]').forEach((el) => {
        el.addEventListener('click', () => {
          state.filter = el.getAttribute('data-cat');
          document.querySelectorAll('[data-cat]').forEach((x) => {
            const active = x.getAttribute('data-cat') === state.filter;
            x.classList.toggle('bg-accent-soft', active);
            x.classList.toggle('text-accent', active);
            x.classList.toggle('font-medium', active);
            x.classList.toggle('bg-white', !active);
            x.classList.toggle('text-ink-mute', !active);
          });
          render();
        });
      });
    }

    async function load() {
      state.loading = true;
      render();
      try {
        state.rows = await listRecent(state.clinicId, 200);
      } catch (err) {
        console.error('[activity] load failed:', err);
        state.rows = [];
      } finally {
        state.loading = false;
        render();
      }
    }

    (async () => {
      const m = await requireAuth();
      if (!isAdmin()) {
        location.replace('/day');
        return;
      }
      state.clinicId = getActiveClinicId();
      wireFilters();
      const refresh = $('#act-refresh');
      if (refresh) refresh.addEventListener('click', () => load());
      await load();
    })();
  </script>
</AppLayout>